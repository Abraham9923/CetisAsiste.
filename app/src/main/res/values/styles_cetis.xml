<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos de CetisAsiste.
      - Cetis.Texto.*: los estilos de texto de Figma (mismo nombre que en el archivo de diseño).
      - El resto: piezas que se repiten en las vistas. Todas las vistas usan ConstraintLayout,
        así que aquí NO hay pesos ni orientaciones de LinearLayout (salvo dentro de los
        RadioGroup): cada vista pone sus restricciones (layout_constraint…) y estos estilos
        solo dan medidas, fondos y letras.
    Si cambias algo aquí, cambia en todas las pantallas.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Raíces de las familias de estilos -->
    <style name="Cetis" />
    <style name="Cetis.Campo" />
    <style name="Cetis.Menu" />
    <style name="Cetis.Seccion" />

    <style name="Cetis.Texto">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/cetis_brand_900</item>
    </style>

    <!-- Brand/AppName · Bold 32 / 38 -->
    <style name="Cetis.Texto.NombreApp">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:lineHeight" tools:targetApi="28">38sp</item>
        <item name="android:textColor">@color/cetis_text_on_brand</item>
    </style>

    <!-- Title/Name · SemiBold 18 / 24 -->
    <style name="Cetis.Texto.TituloNombre">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight" tools:targetApi="28">24sp</item>
    </style>

    <!-- Heading/Banner · SemiBold 17 / 22 -->
    <style name="Cetis.Texto.Banner">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight" tools:targetApi="28">22sp</item>
    </style>

    <!-- Heading/Section · SemiBold 15 / 20 -->
    <style name="Cetis.Texto.Seccion">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight" tools:targetApi="28">20sp</item>
    </style>

    <!-- Body/Default · Regular 14 / 20 -->
    <style name="Cetis.Texto.Cuerpo">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight" tools:targetApi="28">20sp</item>
    </style>

    <!-- Body/Small · Regular 13 / 19 -->
    <style name="Cetis.Texto.CuerpoChico">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight" tools:targetApi="28">19sp</item>
        <item name="android:textColor">@color/cetis_text_secondary</item>
    </style>

    <!-- Card/Title · SemiBold 13.5 / 18 -->
    <style name="Cetis.Texto.TituloTarjeta">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:lineHeight" tools:targetApi="28">18sp</item>
    </style>

    <!-- Card/Subtitle · Regular 11.5 / 15 -->
    <style name="Cetis.Texto.SubtituloTarjeta">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineHeight" tools:targetApi="28">15sp</item>
        <item name="android:textColor">@color/cetis_text_secondary</item>
    </style>


    <!-- Texto gris centrado cuando una lista no tiene nada -->
    <style name="Cetis.Texto.Vacio" parent="Cetis.Texto.Cuerpo">
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
        <item name="android:textColor">@color/cetis_text_secondary</item>
    </style>

    <!-- Enlace subrayado en café ("Ver más", "Marcar todas como leídas") -->
    <style name="Cetis.Texto.Enlace" parent="Cetis.Texto.TituloTarjeta">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/cetis_brand_accent</item>
    </style>

    <!-- Fila "Etiqueta ........ valor" (Perfil, Credencial) -->
    <style name="Cetis.Campo.Etiqueta" parent="Cetis.Texto.SubtituloTarjeta" />
    <style name="Cetis.Campo.Valor" parent="Cetis.Texto.TituloTarjeta">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ================= Esqueleto de pantalla ================= -->

    <!-- Pantalla que cabe: ConstraintLayout de toda la pantalla con 12 dp a los lados -->
    <style name="Cetis.Pantalla">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/cetis_surface_background</item>
        <item name="android:paddingStart">@dimen/cetis_screen_margin</item>
        <item name="android:paddingEnd">@dimen/cetis_screen_margin</item>
    </style>
    <!-- Pantalla que NO cabe: ScrollView de toda la pantalla… -->
    <style name="Cetis.Pantalla.Desplazable">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
    </style>
    <!-- …con un solo ConstraintLayout adentro que lleva todo el contenido -->
    <style name="Cetis.Pantalla.Contenido" parent="Cetis">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/cetis_screen_margin</item>
        <item name="android:paddingEnd">@dimen/cetis_screen_margin</item>
        <item name="android:paddingBottom">@dimen/cetis_space_16</item>
    </style>

    <!-- Lista (RecyclerView). Los renglones llevan su propio margen de arriba. -->
    <style name="Cetis.Lista" parent="Cetis">
        <item name="android:clipToPadding">false</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:paddingBottom">@dimen/cetis_space_16</item>
        <item name="android:scrollbars">none</item>
    </style>
    <!-- Lista dentro de una pantalla con ScrollView: crece con su contenido y no se desplaza sola -->
    <style name="Cetis.Lista.Fija">
        <item name="android:nestedScrollingEnabled">false</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- ================= Barra superior (AppBar de Figma 16:103) ================= -->

    <style name="Cetis.BarraSuperior">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/cetis_app_bar_height</item>
        <item name="android:background">@drawable/shape_header</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
    </style>
    <!-- Adorno diagonal (DiagonalAccent 110 × 80, a 10 dp del borde derecho) -->
    <style name="Cetis.BarraSuperior.Adorno" parent="Cetis">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/bg_header_accent</item>
    </style>
    <!-- Botón ☰: abre el menú lateral del rol (comun_menu.xml). Ícono de 24 dp en 48 dp de toque. -->
    <style name="Cetis.BarraSuperior.Menu" parent="Cetis">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">@string/accion_menu</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_menu</item>
    </style>
    <!-- Campana de notificaciones (ícono de 26 dp en 48 dp de toque) -->
    <style name="Cetis.BarraSuperior.Campana" parent="Cetis">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">@string/titulo_notificaciones</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_bell</item>
    </style>
    <style name="Cetis.BarraSuperior.Titulo" parent="Cetis.Texto.TituloNombre">
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/cetis_text_on_brand</item>
    </style>

    <!-- ================= Piezas de contenido ================= -->

    <!-- Tarjeta sencilla (fondo surface/card, radio 14) -->
    <style name="Cetis.Tarjeta">
        <item name="android:background">@drawable/shape_tarjeta</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
    </style>
    <!-- Tarjeta que se puede tocar (accesos rápidos, opciones, renglones) -->
    <style name="Cetis.Tarjeta.Tocable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Círculo guinda de 40 dp con ícono de 22 dp (IconCircle de las tarjetas) -->
    <style name="Cetis.Circulo">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/shape_circulo_brand</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <!-- Círculo guinda de 36 dp con ícono de 18 dp (componente "Opcion") -->
    <style name="Cetis.Circulo.Chico">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
    </style>
    <!-- Flecha ">" de las tarjetas y opciones (16 dp) -->
    <style name="Cetis.Flecha" parent="Cetis">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_chevron_right_dark</item>
    </style>

    <!-- Título de sección: línea · píldora · línea (SectionLabel de Figma 79:1332) -->
    <style name="Cetis.Seccion.Pildora" parent="Cetis.Texto.Seccion">
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
        <item name="android:background">@drawable/shape_pill</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>
    <style name="Cetis.Seccion.Linea" parent="Cetis">
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/cetis_brand_800</item>
    </style>
    <!-- Subtítulo arriba de una lista ("Mis grupos", "Hoy", "Próximos eventos") -->
    <style name="Cetis.Subtitulo" parent="Cetis.Texto.Seccion">
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <!-- Chip de selección única (RadioButton dentro de un RadioGroup): tipo de estatus -->
    <style name="Cetis.Chip" parent="Cetis.Texto.TituloTarjeta">
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:button">@null</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/cetis_texto_chip</item>
    </style>
    <!-- Chip de día (dentro del RadioGroup de días): cinco del mismo ancho con 8 dp entre ellos -->
    <style name="Cetis.Chip.Dia">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
    <!-- Selector Entrada / Salida (ModeToggle de Figma 78:647): RadioButton dentro de una píldora blanca -->
    <style name="Cetis.Segmento" parent="Cetis.Texto.Seccion">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/selector_segmento</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cetis_texto_chip</item>
    </style>

    <!-- Etiqueta de estado con punto de color (StatusChip de Figma 76:538). El punto es el drawableStart. -->
    <style name="Cetis.Estatus" parent="Cetis.Texto.SubtituloTarjeta">
        <item name="android:background">@drawable/shape_estatus_exito</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableStart">@drawable/shape_punto_exito</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/cetis_status_success</item>
    </style>

    <!-- Contador rojo de avisos sin leer ("3", "9+") -->
    <style name="Cetis.Contador" parent="Cetis.Texto.SubtituloTarjeta">
        <item name="android:background">@drawable/shape_contador</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">20dp</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">@color/cetis_text_on_brand</item>
    </style>

    <!-- ================= Formularios ================= -->

    <!-- Etiqueta de un campo (Campo de Figma 32:423) -->
    <style name="Cetis.Campo.Titulo" parent="Cetis.Texto.TituloTarjeta" />
    <!-- Caja del campo: blanca con borde, 50 dp, ícono a la izquierda (drawableStart) -->
    <style name="Cetis.Campo.Caja" parent="Cetis.Texto.Cuerpo">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/shape_input</item>
        <item name="android:drawablePadding">@dimen/cetis_space_12</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColorHint">@color/cetis_text_secondary</item>
    </style>
    <!-- Ojo para mostrar u ocultar la contraseña: CheckBox (activar / desactivar) con el ícono de Figma -->
    <style name="Cetis.Campo.Ojo" parent="Cetis">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/ic_ojo_contrasena</item>
        <item name="android:button">@null</item>
        <item name="android:contentDescription">@string/accion_mostrar_contrasena</item>
    </style>

    <!-- Botón guinda grande (PrimaryButton de Figma 32:433) -->
    <style name="Cetis.Boton" parent="Cetis.Texto.Seccion">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/shape_boton_primario</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cetis_text_on_brand</item>
    </style>

    <!-- Tecla del teclado numérico de la captura (KeypadKey de Figma "Componentes") -->
    <style name="Cetis.Tecla" parent="Cetis.Texto">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/shape_input</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Cetis.Tecla.Accion">
        <item name="android:background">@drawable/shape_tarjeta</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ================= Menú lateral (comun_menu.xml) ================= -->
    <style name="Cetis.Menu.Texto" parent="Cetis.Texto.Seccion">
        <item name="android:maxLines">1</item>
    </style>
</resources>
