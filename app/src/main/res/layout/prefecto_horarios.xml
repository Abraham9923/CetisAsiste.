<?xml version="1.0" encoding="utf-8"?>
<!-- Horarios de todos los grupos (prefecto). Pestaña: el botón ☰ abre el menú del rol.
     Arriba se elige el turno; abajo, un comun_item_lista por grupo del semestre en curso.
     Al tocar un grupo se abre su horario (comun_horario.xml). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <LinearLayout style="@style/Cetis.Pantalla.Columna">

        <FrameLayout style="@style/Cetis.BarraSuperior">

            <ImageView style="@style/Cetis.BarraSuperior.Adorno" />

            <LinearLayout style="@style/Cetis.BarraSuperior.Fila">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.BarraSuperior.Titulo"
                    android:text="@string/prefecto_titulo_horarios" />
            </LinearLayout>
        </FrameLayout>

        <!-- Turno elegido (el activo va en guinda; lo marca el código) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_matutino"
                style="@style/Cetis.Chip"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:text="@string/turno_matutino"
                tools:background="@drawable/shape_chip_activo"
                tools:textColor="@color/cetis_text_on_brand" />

            <TextView
                android:id="@+id/chip_vespertino"
                style="@style/Cetis.Chip"
                android:text="@string/turno_vespertino" />
        </LinearLayout>

        <ScrollView style="@style/Cetis.Pantalla.Scroll">

            <LinearLayout style="@style/Cetis.Pantalla.Contenido">

                <LinearLayout
                    android:id="@+id/lista_grupos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_8"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_vacio"
                    style="@style/Cetis.Texto.Vacio"
                    android:text="@string/prefecto_grupos_vacio"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
