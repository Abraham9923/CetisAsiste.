<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Horarios de grupos - Prefecto" (77:504): en una sola pantalla se elige el grupo
     (chips), el día (RadioButton) y se ven sus clases. Las clases están en un RecyclerView:
     sin ScrollView. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- GroupPicker (78:970): "Grupo" y un chip por grupo (RecyclerView horizontal con
         comun_item_chip.xml; el elegido va en guinda) -->
    <TextView
        android:id="@+id/etiquetaGrupo"
        style="@style/Cetis.Campo.Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/campo_grupo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaGrupos"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etiquetaGrupo"
        tools:itemCount="5"
        tools:listitem="@layout/comun_item_chip"
        tools:orientation="horizontal" />

    <TextView
        android:id="@+id/textoVacioGrupos"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vacio_grupos"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etiquetaGrupo" />

    <!-- Days (78:982): RadioGroup, se elige UN día -->
    <RadioGroup
        android:id="@+id/grupoDias"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listaGrupos">

        <RadioButton
            android:id="@+id/chipLunes"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_lunes"
            android:text="@string/dia_lunes_corto" />

        <RadioButton
            android:id="@+id/chipMartes"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_martes"
            android:text="@string/dia_martes_corto" />

        <RadioButton
            android:id="@+id/chipMiercoles"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_miercoles"
            android:text="@string/dia_miercoles_corto"
            tools:checked="true" />

        <RadioButton
            android:id="@+id/chipJueves"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_jueves"
            android:text="@string/dia_jueves_corto" />

        <RadioButton
            android:id="@+id/chipViernes"
            style="@style/Cetis.Chip.Dia"
            android:contentDescription="@string/dia_viernes"
            android:text="@string/dia_viernes_corto" />
    </RadioGroup>

    <!-- Classes (78:993) · variables: horario.grupo, horario.dia, horario.clases -->
    <TextView
        android:id="@+id/textoEncabezado"
        style="@style/Cetis.Subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grupoDias"
        tools:text="Grupo {horario.grupo} · {horario.dia}" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaClases"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cetis_space_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEncabezado"
        tools:listitem="@layout/alumno_item_clase" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_8"
        android:text="@string/vacio_clases"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEncabezado" />
</androidx.constraintlayout.widget.ConstraintLayout>
