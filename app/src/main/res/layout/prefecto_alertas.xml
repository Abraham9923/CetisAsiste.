<?xml version="1.0" encoding="utf-8"?>
<!-- Alertas de hoy (prefecto, ADR-010). Pestaña: el botón ☰ abre el menú del rol.
     Todos los escaneos de hoy que tuvieron alerta, del más nuevo al más viejo, en tiempo real:
     un comun_item_lista por alerta (alumno, hora, Entrada o Salida y qué alerta fue).
     Variables: cuántas alertas van hoy y la lista. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <LinearLayout style="@style/Cetis.Pantalla.Columna">

        <FrameLayout style="@style/Cetis.BarraSuperior">

            <ImageView style="@style/Cetis.BarraSuperior.Adorno" />

            <LinearLayout style="@style/Cetis.BarraSuperior.Fila">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.BarraSuperior.Titulo"
                    android:text="@string/prefecto_titulo_alertas" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView style="@style/Cetis.Pantalla.Scroll">

            <LinearLayout style="@style/Cetis.Pantalla.Contenido">

                <!-- "3 alertas hoy" con su contador rojo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_resumen"
                        style="@style/Cetis.Texto.Cuerpo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="{alertas.cuantas}" />

                    <TextView
                        android:id="@+id/txt_contador"
                        style="@style/Cetis.Contador"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        tools:text="3"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lista_alertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_8"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_vacio"
                    style="@style/Cetis.Texto.Vacio"
                    android:text="@string/prefecto_alertas_vacio"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
