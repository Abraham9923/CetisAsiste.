<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Dar salida al grupo - Profesor" (78:1087). Cabe en la pantalla: sin ScrollView.
     Variables: grupo.nombre, la última clase de hoy (materia y horario) y si el grupo ya salió. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- GroupCard (79:763): ícono de grupo, nombre, materia y la última clase -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaGrupo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_tarjeta_lg"
        android:paddingStart="@dimen/cetis_space_20"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/cetis_space_20"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <ImageView
            android:id="@+id/iconoGrupo"
            style="@style/Cetis.Circulo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="16dp"
            android:src="@drawable/ic_users"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoGrupo"
            style="@style/Cetis.Texto.Banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconoGrupo"
            tools:text="Grupo {grupo.nombre}" />

        <TextView
            android:id="@+id/textoMateria"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:textColor="@color/cetis_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoGrupo"
            tools:text="{clase.materia}" />

        <!-- LastClass: píldora verde con el horario de la última clase -->
        <TextView
            android:id="@+id/textoUltimaClase"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:background="@drawable/shape_estatus_exito"
            android:paddingStart="@dimen/cetis_space_12"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/cetis_space_12"
            android:paddingBottom="4dp"
            android:textColor="@color/cetis_status_success"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoMateria"
            tools:text="{clase.horario} · última clase del turno" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Note (79:772) -->
    <TextView
        android:id="@+id/textoNota"
        style="@style/Cetis.Texto.CuerpoChico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_tarjeta_sin_leer"
        android:padding="@dimen/cetis_space_12"
        android:text="@string/nota_dar_salida"
        android:textColor="@color/cetis_brand_900"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaGrupo" />

    <!-- Aviso verde si el grupo ya salió hoy, o el error al guardar (solo se ve si hay uno) -->
    <TextView
        android:id="@+id/textoMensaje"
        style="@style/Cetis.Texto.CuerpoChico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_aviso_exito"
        android:padding="@dimen/cetis_space_12"
        android:textColor="@color/cetis_brand_900"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoNota" />

    <!-- Boton/Dar salida (79:774) -->
    <Button
        android:id="@+id/botonDarSalida"
        style="@style/Cetis.Boton"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/boton_dar_salida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoMensaje" />

    <TextView
        android:id="@+id/textoSoloUltimaClase"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:gravity="center"
        android:text="@string/aviso_solo_ultima_clase"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botonDarSalida" />
</androidx.constraintlayout.widget.ConstraintLayout>
