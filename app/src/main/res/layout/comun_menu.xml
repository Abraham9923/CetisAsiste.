<?xml version="1.0" encoding="utf-8"?>
<!-- Menú hamburguesa (lateral) de todas las pantallas: lo abre el botón ☰ de la barra superior y
     reemplaza a la barra inferior de Figma (ADR-007). No es pantalla (no tiene Activity): el
     código lo pone encima de la pantalla abierta con la capa oscura.
     Arriba, el nombre y el rol; en medio, una opción por pantalla principal (RecyclerView con
     comun_item_menu.xml) y "Notificaciones"; hasta abajo, "Cerrar sesión".
     Variables: persona.nombre, persona.rol y la lista de opciones del rol. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu"
    android:layout_width="@dimen/cetis_menu_width"
    android:layout_height="match_parent"
    android:background="@drawable/shape_menu"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    tools:targetApi="31">

    <!-- Encabezado guinda (mismo color y adorno que la barra superior). El código le suma
         arriba el alto de la barra de estado (hora y batería), que cambia en cada teléfono. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/encabezadoMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/cetis_brand_800"
        android:paddingStart="@dimen/cetis_space_20"
        android:paddingTop="@dimen/cetis_space_20"
        android:paddingEnd="@dimen/cetis_space_20"
        android:paddingBottom="@dimen/cetis_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imagenAdorno"
            style="@style/Cetis.BarraSuperior.Adorno"
            android:layout_marginEnd="0dp"
            android:translationX="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imagenFoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_64"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_12"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cetis_text_on_brand"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagenFoto"
            tools:text="{persona.nombre}" />

        <TextView
            android:id="@+id/textoRol"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="@color/cetis_text_on_brand_muted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoNombre"
            tools:text="{persona.rol}" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Opciones del rol: una por pantalla principal (comun_item_menu.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaOpciones"
        style="@style/Cetis.Lista.Fija"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_12"
        android:layout_marginTop="@dimen/cetis_space_12"
        android:layout_marginEnd="@dimen/cetis_space_12"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezadoMenu"
        tools:itemCount="4"
        tools:listitem="@layout/comun_item_menu" />

    <!-- Notificaciones: la misma pantalla que abre la campana -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opcionNotificaciones"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/cetis_space_12"
        android:layout_marginTop="@dimen/cetis_space_4"
        android:layout_marginEnd="@dimen/cetis_space_12"
        android:background="@null"
        android:contentDescription="@string/titulo_notificaciones"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listaOpciones">

        <ImageView
            android:id="@+id/iconoNotificaciones"
            style="@style/Cetis.Circulo.Chico"
            android:src="@drawable/ic_bell_badge"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoNotificaciones"
            style="@style/Cetis.Menu.Texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:importantForAccessibility="no"
            android:text="@string/titulo_notificaciones"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textoSinLeer"
            app:layout_constraintStart_toEndOf="@id/iconoNotificaciones"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Cuántos avisos sin leer hay ("3", "9+"); se oculta si no hay (lo pone el código) -->
        <TextView
            android:id="@+id/textoSinLeer"
            style="@style/Cetis.Contador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hasta abajo: cerrar sesión (pregunta antes, con el mismo diálogo que Perfil) -->
    <TextView
        android:id="@+id/textoPlantel"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/cetis_space_20"
        android:text="@string/nombre_plantel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opcionCerrarSesion"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/cetis_space_12"
        android:layout_marginEnd="@dimen/cetis_space_12"
        android:background="@null"
        android:contentDescription="@string/opcion_cerrar_sesion"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_12"
        app:layout_constraintBottom_toTopOf="@id/textoPlantel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iconoCerrarSesion"
            style="@style/Cetis.Circulo.Chico"
            android:background="@drawable/shape_circulo_accent"
            android:src="@drawable/ic_log_out"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoCerrarSesion"
            style="@style/Cetis.Menu.Texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:importantForAccessibility="no"
            android:text="@string/opcion_cerrar_sesion"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconoCerrarSesion"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divisor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/cetis_space_20"
        android:layout_marginEnd="@dimen/cetis_space_20"
        android:layout_marginBottom="@dimen/cetis_space_8"
        android:background="@color/cetis_surface_pill"
        app:layout_constraintBottom_toTopOf="@id/opcionCerrarSesion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
