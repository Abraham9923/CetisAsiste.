<?xml version="1.0" encoding="utf-8"?>
<!-- Horario de un grupo (lo ve el padre: el grupo de su hijo). Figma: "Horario - Android" del
     padre (20:98) solo trae el encabezado; el contenido es el de "Horario - Alumno" (79:1147).
     Las clases están en un RecyclerView: sin ScrollView. Los días son RadioButton dentro de un
     RadioGroup: se elige UN solo día (chips de Figma). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Days (79:1449) · el día elegido viene de la variable horario.dia -->
    <RadioGroup
        android:id="@+id/grupoDias"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <RadioButton
            android:id="@+id/chipLunes"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_lunes"
            android:text="@string/dia_lunes_corto" />

        <RadioButton
            android:id="@+id/chipMartes"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_martes"
            android:text="@string/dia_martes_corto" />

        <RadioButton
            android:id="@+id/chipMiercoles"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_miercoles"
            android:text="@string/dia_miercoles_corto"
            tools:checked="true" />

        <RadioButton
            android:id="@+id/chipJueves"
            style="@style/Cetis.Chip.Dia"
            android:layout_marginEnd="@dimen/cetis_space_8"
            android:contentDescription="@string/dia_jueves"
            android:text="@string/dia_jueves_corto" />

        <RadioButton
            android:id="@+id/chipViernes"
            style="@style/Cetis.Chip.Dia"
            android:contentDescription="@string/dia_viernes"
            android:text="@string/dia_viernes_corto" />
    </RadioGroup>

    <!-- Classes (79:1460) · variables: horario.grupo, horario.dia, horario.clases -->
    <TextView
        android:id="@+id/textoEncabezado"
        style="@style/Cetis.Subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grupoDias"
        tools:text="Grupo {horario.grupo} · {horario.dia}" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaClases"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cetis_space_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEncabezado"
        tools:listitem="@layout/alumno_item_clase" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_8"
        android:text="@string/vacio_clases"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEncabezado" />
</androidx.constraintlayout.widget.ConstraintLayout>
