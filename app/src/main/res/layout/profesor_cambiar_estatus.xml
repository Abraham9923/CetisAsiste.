<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Cambiar estatus - Profesor" (78:1086). Tres tipos: Falta, Reporte y Llamada de
     atención, como RadioButton dentro de un RadioGroup (se elige UNO).
     Lleva ScrollView: al abrir el teclado el contenido ya no cabe en la pantalla. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla.Desplazable">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenido"
        style="@style/Cetis.Pantalla.Contenido">

        <include
            android:id="@+id/barraSuperior"
            layout="@layout/comun_barra_superior"
            android:layout_width="0dp"
            android:layout_height="@dimen/cetis_app_bar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Alumno (79:718): a quién se le pone el estatus -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaAlumno"
            style="@style/Cetis.Tarjeta"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:paddingStart="@dimen/cetis_space_12"
            android:paddingEnd="@dimen/cetis_space_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barraSuperior">

            <TextView
                android:id="@+id/textoIniciales"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_circulo_iniciales"
                android:gravity="center"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="{alumno.iniciales}" />

            <TextView
                android:id="@+id/textoNombre"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_12"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@id/textoDetalle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textoIniciales"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="{alumno.nombre}" />

            <TextView
                android:id="@+id/textoDetalle"
                style="@style/Cetis.Texto.SubtituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/textoNombre"
                app:layout_constraintTop_toBottomOf="@id/textoNombre"
                tools:text="Grupo {alumno.grupo} · No. de control {alumno.noControl}" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tipo (79:729): RadioGroup, el profesor elige UN tipo de estatus (chips de Figma) -->
        <TextView
            android:id="@+id/etiquetaTipo"
            style="@style/Cetis.Campo.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:text="@string/campo_tipo_estatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaAlumno" />

        <RadioGroup
            android:id="@+id/grupoTipoEstatus"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etiquetaTipo">

            <RadioButton
                android:id="@+id/chipFalta"
                style="@style/Cetis.Chip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:text="@string/estatus_falta" />

            <RadioButton
                android:id="@+id/chipReporte"
                style="@style/Cetis.Chip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:text="@string/estatus_reporte"
                tools:checked="true" />

            <RadioButton
                android:id="@+id/chipLlamada"
                style="@style/Cetis.Chip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/estatus_llamada_atencion" />
        </RadioGroup>

        <!-- Motivo (79:738): área de texto de 132 dp -->
        <TextView
            android:id="@+id/etiquetaMotivo"
            style="@style/Cetis.Campo.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:labelFor="@+id/campoMotivo"
            android:text="@string/campo_motivo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/grupoTipoEstatus" />

        <EditText
            android:id="@+id/campoMotivo"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="132dp"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:background="@drawable/shape_input"
            android:gravity="top|start"
            android:hint="@string/pista_motivo"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingStart="15.5dp"
            android:paddingTop="13.5dp"
            android:paddingEnd="15.5dp"
            android:paddingBottom="13.5dp"
            android:textColorHint="@color/cetis_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etiquetaMotivo" />

        <!-- Error al revisar o guardar (solo se ve si hay uno) -->
        <TextView
            android:id="@+id/textoMensaje"
            style="@style/Cetis.Texto.CuerpoChico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:textColor="@color/cetis_status_danger"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoMotivo" />

        <Button
            android:id="@+id/botonGuardar"
            style="@style/Cetis.Boton"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:text="@string/boton_guardar_estatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoMensaje" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
