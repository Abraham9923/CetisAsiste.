<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Boletin - Alumno" (79:1218). La lista se desplaza sola (RecyclerView): sin ScrollView. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- AnnouncementList (79:1230) · variable: lista de anuncios (alumno_item_anuncio.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaAnuncios"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior"
        tools:listitem="@layout/alumno_item_anuncio" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/vacio_anuncios"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />
</androidx.constraintlayout.widget.ConstraintLayout>
