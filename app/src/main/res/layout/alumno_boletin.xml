<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Boletin - Alumno (79:1218)" -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cetis_surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/cetis_screen_margin"
        android:paddingEnd="@dimen/cetis_screen_margin">
        <!-- AppBar (Figma 16:103) -->
        <FrameLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cetis_app_bar_height"
            android:background="@drawable/shape_header"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="80dp"
                android:layout_gravity="end"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_header_accent" />

            <!-- La hora y la batería las dibuja Android en la zona superior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/cetis_space_16"
                android:paddingEnd="@dimen/cetis_space_16">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.Texto.TituloNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:maxLines="1"
                    android:text="@string/alumno_titulo_boletin"
                    android:textColor="@color/cetis_text_on_brand" />
            </LinearLayout>
        </FrameLayout>
        <!-- AnnouncementList (79:1230) · variable: lista de anuncios -->
        <ListView
            android:id="@+id/lista_anuncios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/cetis_space_12"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="@dimen/cetis_space_16"
            android:scrollbars="none"
            tools:listitem="@layout/alumno_item_anuncio" />
    </LinearLayout>
</FrameLayout>
