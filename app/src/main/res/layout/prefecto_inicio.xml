<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Inicio - Prefecto" (77:499). La lista de últimos escaneos puede crecer: la pantalla
     no cabe y lleva ScrollView con un solo ConstraintLayout adentro.
     Las salidas de grupo están en Notificaciones y las alertas de hoy en el menú ☰ (como en Figma).
     Diferencias permitidas: menú ☰ en lugar de la barra de abajo y la campana arriba. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla.Desplazable">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenido"
        style="@style/Cetis.Pantalla.Contenido">

        <include
            android:id="@+id/barraInicio"
            layout="@layout/comun_barra_inicio"
            android:layout_width="0dp"
            android:layout_height="@dimen/cetis_app_bar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Greeting: nombre y área -->
        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barraInicio"
            tools:text="{personal.nombre}" />

        <TextView
            android:id="@+id/textoArea"
            style="@style/Cetis.Texto.CuerpoChico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/area_prefectura_plantel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoNombre" />

        <!-- ScanCTA (78:523) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaEscanear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:background="@drawable/shape_tarjeta_brand"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="88dp"
            android:padding="@dimen/cetis_space_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoArea">

            <ImageView
                android:id="@+id/tarjetaEscanearIcono"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shape_circulo_blanco"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_scan"
                android:tint="@color/cetis_brand_800"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tarjetaEscanearTitulo"
                style="@style/Cetis.Texto.Banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_16"
                android:layout_marginEnd="@dimen/cetis_space_16"
                android:text="@string/acceso_escanear_qr"
                android:textColor="@color/cetis_text_on_brand"
                app:layout_constraintBottom_toTopOf="@id/tarjetaEscanearDetalle"
                app:layout_constraintEnd_toStartOf="@id/tarjetaEscanearFlecha"
                app:layout_constraintStart_toEndOf="@id/tarjetaEscanearIcono"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tarjetaEscanearDetalle"
                style="@style/Cetis.Texto.CuerpoChico"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/acceso_escanear_qr_detalle"
                android:textColor="@color/cetis_text_on_brand_muted"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/tarjetaEscanearTitulo"
                app:layout_constraintStart_toStartOf="@id/tarjetaEscanearTitulo"
                app:layout_constraintTop_toBottomOf="@id/tarjetaEscanearTitulo" />

            <ImageView
                android:id="@+id/tarjetaEscanearFlecha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_light"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Rejilla de accesos: dos columnas de 162 dp con 12 dp entre ellas -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guiaCentro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- Card/Horarios -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaHorarios"
            style="@style/Cetis.Tarjeta.Tocable"
            android:layout_width="0dp"
            android:layout_height="128dp"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:padding="@dimen/cetis_space_12"
            android:layout_marginEnd="6dp"
            app:layout_constraintEnd_toStartOf="@id/guiaCentro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaEscanear">

            <ImageView
                android:id="@+id/tarjetaHorariosIcono"
                style="@style/Cetis.Circulo"
                android:src="@drawable/ic_clock"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/tarjetaHorariosFlecha"
                style="@style/Cetis.Flecha"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tarjetaHorariosTitulo"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cetis_space_8"
                android:text="@string/acceso_horarios_grupos"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaHorariosIcono" />

            <TextView
                android:id="@+id/tarjetaHorariosDetalle"
                style="@style/Cetis.Texto.SubtituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/acceso_horarios_grupos_detalle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaHorariosTitulo" />

            <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
            <ImageView
                android:id="@+id/tarjetaHorariosEsquina"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:translationX="@dimen/cetis_space_12"
                android:translationY="@dimen/cetis_space_12"
                android:src="@drawable/img_corner_accent_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card/Calendario -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaCalendario"
            style="@style/Cetis.Tarjeta.Tocable"
            android:layout_width="0dp"
            android:layout_height="128dp"
            android:padding="@dimen/cetis_space_12"
            android:layout_marginStart="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guiaCentro"
            app:layout_constraintTop_toTopOf="@id/tarjetaHorarios">

            <ImageView
                android:id="@+id/tarjetaCalendarioIcono"
                style="@style/Cetis.Circulo"
                android:src="@drawable/ic_calendar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/tarjetaCalendarioFlecha"
                style="@style/Cetis.Flecha"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tarjetaCalendarioTitulo"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cetis_space_8"
                android:text="@string/acceso_calendario"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaCalendarioIcono" />

            <TextView
                android:id="@+id/tarjetaCalendarioDetalle"
                style="@style/Cetis.Texto.SubtituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/acceso_calendario_detalle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaCalendarioTitulo" />

            <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
            <ImageView
                android:id="@+id/tarjetaCalendarioEsquina"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:translationX="@dimen/cetis_space_12"
                android:translationY="@dimen/cetis_space_12"
                android:src="@drawable/img_corner_accent_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- RecentScans (78:567): últimos escaneos de hoy, en tiempo real (comun_item_lista.xml) -->
        <TextView
            android:id="@+id/textoUltimosEscaneos"
            style="@style/Cetis.Subtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:text="@string/seccion_ultimos_escaneos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaHorarios" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaEscaneos"
            style="@style/Cetis.Lista.Fija"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoUltimosEscaneos"
            tools:itemCount="3"
            tools:listitem="@layout/comun_item_lista" />

        <TextView
            android:id="@+id/textoVacioEscaneos"
            style="@style/Cetis.Texto.Vacio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vacio_escaneos"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/listaEscaneos" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
