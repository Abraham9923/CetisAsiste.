<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Horario - Alumno (79:1147)" -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cetis_surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/cetis_screen_margin"
        android:paddingEnd="@dimen/cetis_screen_margin">
        <!-- AppBar (Figma 16:103) -->
        <FrameLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cetis_app_bar_height"
            android:background="@drawable/shape_header"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="80dp"
                android:layout_gravity="end"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_header_accent" />

            <!-- La hora y la batería las dibuja Android en la zona superior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/cetis_space_16"
                android:paddingEnd="@dimen/cetis_space_16">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.Texto.TituloNombre"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:maxLines="1"
                    android:text="@string/alumno_titulo_horario"
                    android:textColor="@color/cetis_text_on_brand" />
                <!-- Campana: la muestra y la conecta el código (PantallaXml) -->
                <ImageButton
                    android:id="@+id/btn_notificaciones"
                    style="@style/Cetis.BarraSuperior.Campana"
                    android:layout_marginStart="@dimen/cetis_space_8"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
        <!-- Days (79:1449) · el día activo viene de la variable horario.dia -->
        <LinearLayout
            android:id="@+id/dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_lunes"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:layout_weight="1"
                android:background="@drawable/shape_chip"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/alumno_dia_lunes_corto" />

            <TextView
                android:id="@+id/chip_martes"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:layout_weight="1"
                android:background="@drawable/shape_chip"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/alumno_dia_martes_corto" />

            <TextView
                android:id="@+id/chip_miercoles"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:layout_weight="1"
                android:background="@drawable/shape_chip"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/alumno_dia_miercoles_corto"
                tools:background="@drawable/shape_chip_activo"
                tools:textColor="@color/cetis_text_on_brand" />

            <TextView
                android:id="@+id/chip_jueves"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/cetis_space_8"
                android:layout_weight="1"
                android:background="@drawable/shape_chip"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/alumno_dia_jueves_corto" />

            <TextView
                android:id="@+id/chip_viernes"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_chip"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/alumno_dia_viernes_corto" />
        </LinearLayout>

        <!-- Classes (79:1460) · variables: horario.grupo, horario.dia, horario.clases -->
        <TextView
            android:id="@+id/txt_encabezado"
            style="@style/Cetis.Texto.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:accessibilityHeading="true"
            tools:text="Grupo {horario.grupo} · {horario.dia}" />

        <ListView
            android:id="@+id/lista_clases"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/cetis_space_8"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="@dimen/cetis_space_16"
            android:scrollbars="none"
            tools:listitem="@layout/alumno_item_clase" />
    </LinearLayout>
</FrameLayout>
