<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Inicio - Alumno" (79:1146). Cabe en la pantalla: sin ScrollView.
     Diferencias permitidas: menú ☰ en lugar de la barra de abajo y la campana arriba. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <!-- Header (79:1300) -->
    <include
        android:id="@+id/barraInicio"
        layout="@layout/comun_barra_inicio"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ProfileCard (79:1321) · variables: alumno.nombre, alumno.rol, alumno.grupo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaPerfil"
        style="@style/Cetis.Tarjeta"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraInicio">

        <!-- WatermarkGear + Watermark61 (detrás del texto) -->
        <ImageView
            android:id="@+id/imagenMarcaAgua"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/img_watermark_gear_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoMarcaAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="19dp"
            android:alpha="0.09"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:importantForAccessibility="no"
            android:text="@string/marca_agua_numero"
            android:textColor="@color/cetis_brand_800"
            android:textSize="40sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imagenFoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:contentDescription="@string/descripcion_foto_alumno"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_64"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:layout_marginEnd="@dimen/cetis_space_16"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/textoRol"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imagenFoto"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="{alumno.nombre}" />

        <TextView
            android:id="@+id/textoRol"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/textoGrupo"
            app:layout_constraintEnd_toEndOf="@id/textoNombre"
            app:layout_constraintStart_toStartOf="@id/textoNombre"
            app:layout_constraintTop_toBottomOf="@id/textoNombre"
            tools:text="{alumno.rol}" />

        <TextView
            android:id="@+id/textoGrupo"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textoNombre"
            app:layout_constraintStart_toStartOf="@id/textoNombre"
            app:layout_constraintTop_toBottomOf="@id/textoRol"
            tools:text="{alumno.grupo}" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SectionLabel (79:1332): línea · "Accesos Rápidos" · línea -->
    <TextView
        android:id="@+id/textoAccesosRapidos"
        style="@style/Cetis.Seccion.Pildora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/seccion_accesos_rapidos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaPerfil" />

    <View
        android:id="@+id/lineaIzquierda"
        style="@style/Cetis.Seccion.Linea"
        android:layout_width="0dp"
        android:layout_marginEnd="@dimen/cetis_space_12"
        app:layout_constraintBottom_toBottomOf="@id/textoAccesosRapidos"
        app:layout_constraintEnd_toStartOf="@id/textoAccesosRapidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoAccesosRapidos" />

    <View
        android:id="@+id/lineaDerecha"
        style="@style/Cetis.Seccion.Linea"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/cetis_space_12"
        app:layout_constraintBottom_toBottomOf="@id/textoAccesosRapidos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textoAccesosRapidos"
        app:layout_constraintTop_toTopOf="@id/textoAccesosRapidos" />

    <!-- QuickAccessGrid (79:1337): dos columnas de 162 dp con 12 dp entre ellas -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Card/QR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaQr"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:layout_marginEnd="6dp"
        android:padding="@dimen/cetis_space_12"
        app:layout_constraintEnd_toStartOf="@id/guiaCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoAccesosRapidos">

        <ImageView
            android:id="@+id/iconoQr"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_qr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/flechaQr"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tituloQr"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_codigo_qr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconoQr" />

        <TextView
            android:id="@+id/subtituloQr"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_codigo_qr_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tituloQr" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card/Credencial (la única con CornerAccent en Figma) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaCredencial"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaCentro"
        app:layout_constraintTop_toTopOf="@id/tarjetaQr">

        <ImageView
            android:id="@+id/iconoCredencial"
            style="@style/Cetis.Circulo"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginTop="@dimen/cetis_space_12"
            android:src="@drawable/ic_id_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/flechaCredencial"
            style="@style/Cetis.Flecha"
            android:layout_marginTop="@dimen/cetis_space_12"
            android:layout_marginEnd="@dimen/cetis_space_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tituloCredencial"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:text="@string/acceso_credencial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/iconoCredencial"
            app:layout_constraintTop_toBottomOf="@id/iconoCredencial" />

        <TextView
            android:id="@+id/subtituloCredencial"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_credencial_detalle"
            app:layout_constraintEnd_toEndOf="@id/tituloCredencial"
            app:layout_constraintStart_toStartOf="@id/tituloCredencial"
            app:layout_constraintTop_toBottomOf="@id/tituloCredencial" />

        <!-- CornerAccent: pegado a la esquina inferior derecha -->
        <ImageView
            android:id="@+id/imagenEsquina"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:src="@drawable/img_corner_accent_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card/Horario -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaHorario"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginTop="@dimen/cetis_space_12"
        android:layout_marginEnd="6dp"
        android:padding="@dimen/cetis_space_12"
        app:layout_constraintEnd_toStartOf="@id/guiaCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaQr">

        <ImageView
            android:id="@+id/iconoHorario"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_clock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/flechaHorario"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tituloHorario"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_horario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconoHorario" />

        <TextView
            android:id="@+id/subtituloHorario"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_horario_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tituloHorario" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card/Boletin -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaBoletin"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginStart="6dp"
        android:padding="@dimen/cetis_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaCentro"
        app:layout_constraintTop_toTopOf="@id/tarjetaHorario">

        <ImageView
            android:id="@+id/iconoBoletin"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_announcements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/flechaBoletin"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tituloBoletin"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_boletin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconoBoletin" />

        <TextView
            android:id="@+id/subtituloBoletin"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_boletin_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tituloBoletin" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
