<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Codigo QR - Alumno" (79:1149). Cabe en la pantalla: sin ScrollView.
     También la abre el padre (el QR de su hijo). Variables: alumno.nombre, alumno.rol, alumno.grupo
     y la imagen del QR (la dibuja la app con el No. de control). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- QRCard (79:1151): tarjeta de radio 20, relleno 20, todo centrado con 12 dp entre piezas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaQr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_tarjeta_lg"
        android:padding="@dimen/cetis_space_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="{alumno.nombre}" />

        <TextView
            android:id="@+id/textoRolGrupo"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_12"
            android:gravity="center"
            android:textColor="@color/cetis_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoNombre"
            tools:text="{alumno.rol} · Grupo {alumno.grupo}" />

        <!-- QRBox: caja blanca con 16 dp alrededor del código de 200 × 200 -->
        <ImageView
            android:id="@+id/imagenQr"
            android:layout_width="232dp"
            android:layout_height="232dp"
            android:layout_marginTop="@dimen/cetis_space_12"
            android:background="@drawable/shape_caja_blanca"
            android:contentDescription="@string/descripcion_codigo_qr"
            android:padding="@dimen/cetis_space_16"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoRolGrupo"
            tools:src="@drawable/img_qr_placeholder" />

        <TextView
            android:id="@+id/textoPie"
            style="@style/Cetis.Texto.CuerpoChico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_12"
            android:gravity="center"
            android:text="@string/pie_codigo_qr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagenQr" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
