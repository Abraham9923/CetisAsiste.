<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "LogoutDialog" (124:2023). Es un diálogo (no es pantalla, no tiene
     Activity): la app lo muestra encima de la pantalla con la capa oscura, como en los frames
     "Confirmar cerrar sesion" de cada rol. Lo usan todos los roles. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="296dp"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_blanco_lg"
    android:elevation="12dp"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Círculo guinda de 56 con el ícono de salida de 28 -->
    <ImageView
        android:id="@+id/iconoCerrarSesion"
        style="@style/Cetis.Circulo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="14dp"
        android:src="@drawable/ic_log_out"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textoTitulo"
        style="@style/Cetis.Texto.Banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_12"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/dialogo_cerrar_sesion_titulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconoCerrarSesion" />

    <TextView
        android:id="@+id/textoMensaje"
        style="@style/Cetis.Texto.CuerpoChico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_12"
        android:gravity="center"
        android:text="@string/dialogo_cerrar_sesion_mensaje"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoTitulo" />

    <!-- Actions: dos botones del mismo ancho con 12 dp entre ellos -->
    <Button
        android:id="@+id/botonCancelar"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/shape_boton_dialogo_borde"
        android:clipToOutline="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:stateListAnimator="@null"
        android:text="@string/dialogo_cerrar_sesion_cancelar"
        android:textAllCaps="false"
        android:textColor="@color/cetis_brand_800"
        app:layout_constraintEnd_toStartOf="@id/botonConfirmar"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoMensaje" />

    <Button
        android:id="@+id/botonConfirmar"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/shape_boton_dialogo"
        android:clipToOutline="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:stateListAnimator="@null"
        android:text="@string/dialogo_cerrar_sesion_confirmar"
        android:textAllCaps="false"
        android:textColor="@color/cetis_text_on_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/botonCancelar"
        app:layout_constraintTop_toTopOf="@id/botonCancelar" />
</androidx.constraintlayout.widget.ConstraintLayout>
