<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "Notif" (32:461). Renglón de lista (RecyclerView), no es pantalla.
     Sin leer: fondo surface/pill y punto rojo a la derecha. Leída: fondo surface/card sin punto.
     Variables: notificacion.titulo, notificacion.hora, notificacion.texto. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/cetis_space_8"
    android:padding="@dimen/cetis_space_12">

    <ImageView
        android:id="@+id/circuloIcono"
        style="@style/Cetis.Circulo"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_log_in" />

    <TextView
        android:id="@+id/textoTitulo"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_12"
        android:layout_marginEnd="@dimen/cetis_space_8"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@id/textoHora"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/circuloIcono"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="{notificacion.titulo}" />

    <TextView
        android:id="@+id/textoHora"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/cetis_space_12"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@id/textoTitulo"
        app:layout_constraintEnd_toStartOf="@id/imagenSinLeer"
        app:layout_constraintTop_toTopOf="@id/textoTitulo"
        app:layout_goneMarginEnd="0dp"
        tools:text="{notificacion.hora}" />

    <TextView
        android:id="@+id/textoMensaje"
        style="@style/Cetis.Texto.CuerpoChico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@id/textoHora"
        app:layout_constraintStart_toStartOf="@id/textoTitulo"
        app:layout_constraintTop_toBottomOf="@id/textoTitulo"
        tools:text="{notificacion.texto}" />

    <!-- UnreadDotWrap (8 × 14) -->
    <ImageView
        android:id="@+id/imagenSinLeer"
        android:layout_width="8dp"
        android:layout_height="14dp"
        android:contentDescription="@string/descripcion_sin_leer"
        android:src="@drawable/img_unread_dot"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
