<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Credencial digital - Alumno" (79:1176). Cabe en la pantalla: sin ScrollView.
     También la abre el padre (la credencial de su hijo).
     Variables: alumno.nombre, alumno.rol, alumno.grupo, alumno.noControl, alumno.vigencia -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CredentialCard (79:1178): tarjeta blanca con sombra; banda guinda, cuerpo y pie con el logo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaCredencial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_blanco_lg"
        android:clipToOutline="true"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <!-- Band (71 dp) -->
        <View
            android:id="@+id/banda"
            android:layout_width="0dp"
            android:layout_height="71dp"
            android:background="@drawable/shape_credencial_banda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoEtiquetaBanda"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:text="@string/credencial_etiqueta_banda"
            android:textColor="@color/cetis_text_on_brand_muted"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoPlantel"
            style="@style/Cetis.Texto.Banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nombre_plantel"
            android:textColor="@color/cetis_text_on_brand"
            app:layout_constraintStart_toStartOf="@id/textoEtiquetaBanda"
            app:layout_constraintTop_toBottomOf="@id/textoEtiquetaBanda" />

        <!-- Body: foto de 96, nombre, rol y los datos -->
        <ImageView
            android:id="@+id/imagenFoto"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="@dimen/cetis_space_20"
            android:contentDescription="@string/descripcion_foto_alumno"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_96"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/banda" />

        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagenFoto"
            tools:text="{alumno.nombre}" />

        <TextView
            android:id="@+id/textoRol"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:textColor="@color/cetis_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoNombre"
            tools:text="{alumno.rol}" />

        <!-- Fields: tarjeta interna con 12 dp de relleno -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaDatos"
            style="@style/Cetis.Tarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_20"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:layout_marginEnd="@dimen/cetis_space_20"
            android:padding="@dimen/cetis_space_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoRol">

            <TextView
                android:id="@+id/etiquetaGrupo"
                style="@style/Cetis.Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campo_grupo"
                app:layout_constraintBottom_toBottomOf="@id/textoGrupo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textoGrupo" />

            <TextView
                android:id="@+id/textoGrupo"
                style="@style/Cetis.Campo.Valor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_12"
                android:layout_marginTop="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/etiquetaGrupo"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="{alumno.grupo}" />

            <TextView
                android:id="@+id/etiquetaNoControl"
                style="@style/Cetis.Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campo_no_control"
                app:layout_constraintBottom_toBottomOf="@id/textoNoControl"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textoNoControl" />

            <TextView
                android:id="@+id/textoNoControl"
                style="@style/Cetis.Campo.Valor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_12"
                android:layout_marginTop="@dimen/cetis_space_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/etiquetaNoControl"
                app:layout_constraintTop_toBottomOf="@id/textoGrupo"
                tools:text="{alumno.noControl}" />

            <TextView
                android:id="@+id/etiquetaVigencia"
                style="@style/Cetis.Campo.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/campo_vigencia"
                app:layout_constraintBottom_toBottomOf="@id/textoVigencia"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textoVigencia" />

            <TextView
                android:id="@+id/textoVigencia"
                style="@style/Cetis.Campo.Valor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_12"
                android:layout_marginTop="@dimen/cetis_space_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/etiquetaVigencia"
                app:layout_constraintTop_toBottomOf="@id/textoNoControl"
                tools:text="{alumno.vigencia}" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Footer: logo del CETis 61 (150 × 51.9) con 12 dp arriba y abajo -->
        <ImageView
            android:id="@+id/imagenLogo"
            android:layout_width="150dp"
            android:layout_height="51.89dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="@dimen/cetis_space_12"
            android:contentDescription="@string/descripcion_logo_plantel"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_cetis61"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaDatos" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
