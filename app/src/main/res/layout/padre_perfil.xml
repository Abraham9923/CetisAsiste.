<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Perfil - Android" del padre (22:242). Cabe en la pantalla: sin ScrollView.
     Muestra los datos del hijo. "Cerrar sesión" abre el diálogo alumno_dialogo_cerrar_sesion.xml.
     El texto "Matrícula" de Figma es "No. de control" desde ADR-009. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ProfileHeader (tarjeta de 104 dp con el avatar de 72) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaPerfil"
        style="@style/Cetis.Tarjeta"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <ImageView
            android:id="@+id/imagenFoto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:contentDescription="@string/descripcion_foto"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_72"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:layout_marginEnd="@dimen/cetis_space_16"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/textoRolGrupo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imagenFoto"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="{alumno.nombre}" />

        <TextView
            android:id="@+id/textoRolGrupo"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="@color/cetis_text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textoNombre"
            app:layout_constraintStart_toStartOf="@id/textoNombre"
            app:layout_constraintTop_toBottomOf="@id/textoNombre"
            tools:text="{alumno.rol} · Grupo {alumno.grupo}" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Info: renglones "Etiqueta ........ valor" -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaDatos"
        style="@style/Cetis.Tarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:padding="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaPerfil">

        <TextView
            android:id="@+id/etiquetaNoControl"
            style="@style/Cetis.Campo.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/campo_no_control"
            app:layout_constraintBottom_toBottomOf="@id/textoNoControl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textoNoControl" />

        <TextView
            android:id="@+id/textoNoControl"
            style="@style/Cetis.Campo.Valor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginTop="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etiquetaNoControl"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="{alumno.noControl}" />

        <TextView
            android:id="@+id/etiquetaGrupo"
            style="@style/Cetis.Campo.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/campo_grupo"
            app:layout_constraintBottom_toBottomOf="@id/textoGrupo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textoGrupo" />

        <TextView
            android:id="@+id/textoGrupo"
            style="@style/Cetis.Campo.Valor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginTop="@dimen/cetis_space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etiquetaGrupo"
            app:layout_constraintTop_toBottomOf="@id/textoNoControl"
            tools:text="{alumno.grupo}" />

        <TextView
            android:id="@+id/etiquetaCorreo"
            style="@style/Cetis.Campo.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/campo_correo"
            app:layout_constraintBottom_toBottomOf="@id/textoCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textoCorreo" />

        <TextView
            android:id="@+id/textoCorreo"
            style="@style/Cetis.Campo.Valor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginTop="@dimen/cetis_space_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etiquetaCorreo"
            app:layout_constraintTop_toBottomOf="@id/textoGrupo"
            tools:text="{alumno.correo}" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Options -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opcionCredencial"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaDatos">

        <ImageView
            android:id="@+id/opcionCredencialIcono"
            style="@style/Cetis.Circulo.Chico"
            android:src="@drawable/ic_id_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/opcionCredencialTexto"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:text="@string/opcion_mi_credencial"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/opcionCredencialFlecha"
            app:layout_constraintStart_toEndOf="@id/opcionCredencialIcono"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/opcionCredencialFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opcionEntradas"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/cetis_space_8"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/opcionCredencial">

        <ImageView
            android:id="@+id/opcionEntradasIcono"
            style="@style/Cetis.Circulo.Chico"
            android:src="@drawable/ic_inbox"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/opcionEntradasTexto"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:text="@string/opcion_mis_entradas_salidas"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/opcionEntradasFlecha"
            app:layout_constraintStart_toEndOf="@id/opcionEntradasIcono"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/opcionEntradasFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opcionContrasena"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/cetis_space_8"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/opcionEntradas">

        <ImageView
            android:id="@+id/opcionContrasenaIcono"
            style="@style/Cetis.Circulo.Chico"
            android:src="@drawable/ic_lock"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/opcionContrasenaTexto"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:text="@string/opcion_cambiar_contrasena"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/opcionContrasenaFlecha"
            app:layout_constraintStart_toEndOf="@id/opcionContrasenaIcono"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/opcionContrasenaFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/opcionCerrarSesion"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/cetis_space_8"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/opcionContrasena">

        <ImageView
            android:id="@+id/opcionCerrarSesionIcono"
            style="@style/Cetis.Circulo.Chico"
            android:background="@drawable/shape_circulo_accent"
            android:src="@drawable/ic_log_out"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/opcionCerrarSesionTexto"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:text="@string/opcion_cerrar_sesion"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/opcionCerrarSesionFlecha"
            app:layout_constraintStart_toEndOf="@id/opcionCerrarSesionIcono"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/opcionCerrarSesionFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
