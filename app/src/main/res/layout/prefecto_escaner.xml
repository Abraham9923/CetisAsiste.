<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Escaner - Prefecto" (77:500). Pantalla del menú ☰ del prefecto.
     Arriba se elige Entrada o Salida; la cámara busca el QR del alumno (lleva
     "CETIS61:" + su No. de control). Si el QR no se lee, "Escribir No. de control".
     La cámara es la vista BarcodeView de la librería zxing-android-embedded (ADR-009).
     Variables: tipo (entrada o salida), el mensaje de estado y si hay permiso de cámara. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla"
    android:background="@color/cetis_escaner_fondo">

    <LinearLayout style="@style/Cetis.Pantalla.Columna">

        <FrameLayout style="@style/Cetis.BarraSuperior">

            <ImageView style="@style/Cetis.BarraSuperior.Adorno" />

            <LinearLayout style="@style/Cetis.BarraSuperior.Fila">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.BarraSuperior.Titulo"
                    android:text="@string/prefecto_titulo_escanear" />
                <!-- Campana: la muestra y la conecta el código (PantallaXml) -->
                <ImageButton
                    android:id="@+id/btn_notificaciones"
                    style="@style/Cetis.BarraSuperior.Campana"
                    android:layout_marginStart="@dimen/cetis_space_8"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView style="@style/Cetis.Pantalla.Scroll">

            <LinearLayout style="@style/Cetis.Pantalla.Contenido">

                <!-- Entrada / Salida (la elegida va en guinda; lo marca el código) -->
                <LinearLayout style="@style/Cetis.Segmento">

                    <TextView
                        android:id="@+id/opcion_entrada"
                        style="@style/Cetis.Segmento.Opcion"
                        android:text="@string/prefecto_entrada"
                        tools:background="@drawable/shape_chip_activo"
                        tools:textColor="@color/cetis_text_on_brand" />

                    <TextView
                        android:id="@+id/opcion_salida"
                        style="@style/Cetis.Segmento.Opcion"
                        android:text="@string/prefecto_salida" />
                </LinearLayout>

                <!-- Cámara con el marco de cuatro esquinas y la línea roja -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="@dimen/cetis_space_16">

                    <com.journeyapps.barcodescanner.BarcodeView
                        android:id="@+id/camara"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/img_marco_escaner" />

                    <View
                        android:layout_width="210dp"
                        android:layout_height="3dp"
                        android:layout_gravity="center"
                        android:background="@color/cetis_status_danger" />

                    <!-- Sin permiso de cámara: aviso y botón para pedirlo otra vez -->
                    <LinearLayout
                        android:id="@+id/aviso_permiso"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/cetis_escaner_fondo"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/cetis_space_20"
                        android:visibility="gone">

                        <TextView
                            style="@style/Cetis.Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/prefecto_permiso_camara"
                            android:textColor="@color/cetis_text_on_brand" />

                        <TextView
                            android:id="@+id/btn_permiso"
                            style="@style/Cetis.Texto.Seccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cetis_space_16"
                            android:background="@drawable/shape_boton_borde_claro"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="@dimen/cetis_space_20"
                            android:paddingTop="@dimen/cetis_space_12"
                            android:paddingEnd="@dimen/cetis_space_20"
                            android:paddingBottom="@dimen/cetis_space_12"
                            android:text="@string/prefecto_dar_permiso"
                            android:textColor="@color/cetis_text_on_brand" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    style="@style/Cetis.Texto.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_20"
                    android:gravity="center"
                    android:text="@string/prefecto_apunta_camara"
                    android:textColor="@color/cetis_text_on_brand_muted" />

                <!-- "Registrando: Entrada" -->
                <TextView
                    android:id="@+id/txt_registrando"
                    style="@style/Cetis.Texto.Seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:gravity="center"
                    android:textColor="@color/cetis_text_on_brand"
                    tools:text="Registrando: Entrada" />

                <!-- "Buscando al alumno…" o "Ese código no es de CetisAsiste." -->
                <TextView
                    android:id="@+id/txt_estado"
                    style="@style/Cetis.Texto.Cuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_8"
                    android:gravity="center"
                    android:textColor="@color/cetis_text_on_brand"
                    android:visibility="gone"
                    tools:text="{mensaje}"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/btn_escribir"
                    style="@style/Cetis.Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/cetis_space_20"
                    android:background="@drawable/shape_boton_borde_claro"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/cetis_space_20"
                    android:paddingTop="@dimen/cetis_space_12"
                    android:paddingEnd="@dimen/cetis_space_20"
                    android:paddingBottom="@dimen/cetis_space_12"
                    android:text="@string/prefecto_escribir_no_control"
                    android:textColor="@color/cetis_text_on_brand" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
