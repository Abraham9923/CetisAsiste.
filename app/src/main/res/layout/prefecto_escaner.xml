<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Escaner - Prefecto" (77:500). Cabe en la pantalla: sin ScrollView.
     Arriba se elige Entrada o Salida (RadioButton); la cámara busca el QR del alumno (lleva
     "CETIS61:" + su No. de control). Si el QR no se lee, "Escribir No. de control".
     La cámara es la vista BarcodeView de la librería zxing-android-embedded (ADR-009).
     El texto "matrícula" de Figma es "No. de control" desde ADR-009. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla"
    android:background="@color/cetis_escaner_fondo">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ModeToggle (78:647): Entrada o Salida. RadioGroup: se elige UNA de las dos -->
    <RadioGroup
        android:id="@+id/grupoTipo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_segmento"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <RadioButton
            android:id="@+id/opcionEntrada"
            style="@style/Cetis.Segmento"
            android:checked="true"
            android:text="@string/tipo_entrada" />

        <RadioButton
            android:id="@+id/opcionSalida"
            style="@style/Cetis.Segmento"
            android:text="@string/tipo_salida" />
    </RadioGroup>

    <!-- Camera (78:652): la vista de la cámara con el marco de cuatro esquinas y la línea roja -->
    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/camara"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grupoTipo" />

    <ImageView
        android:id="@+id/imagenMarco"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:src="@drawable/img_marco_escaner"
        app:layout_constraintBottom_toBottomOf="@id/camara"
        app:layout_constraintEnd_toEndOf="@id/camara"
        app:layout_constraintStart_toStartOf="@id/camara"
        app:layout_constraintTop_toTopOf="@id/camara" />

    <!-- ScanLine: 210 × 3 en medio del marco -->
    <View
        android:id="@+id/lineaEscaneo"
        android:layout_width="210dp"
        android:layout_height="3dp"
        android:background="@color/cetis_status_danger"
        app:layout_constraintBottom_toBottomOf="@id/camara"
        app:layout_constraintEnd_toEndOf="@id/camara"
        app:layout_constraintStart_toStartOf="@id/camara"
        app:layout_constraintTop_toTopOf="@id/camara" />

    <!-- Sin permiso de cámara: aviso y botón para pedirlo otra vez (tapan la cámara) -->
    <TextView
        android:id="@+id/textoPermiso"
        style="@style/Cetis.Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cetis_escaner_fondo"
        android:gravity="center"
        android:paddingStart="@dimen/cetis_space_20"
        android:paddingEnd="@dimen/cetis_space_20"
        android:paddingBottom="56dp"
        android:text="@string/permiso_camara"
        android:textColor="@color/cetis_text_on_brand"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/camara"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/camara" />

    <Button
        android:id="@+id/botonPermiso"
        style="@style/Cetis.Texto.Seccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cetis_space_16"
        android:background="@drawable/shape_boton_borde_claro"
        android:minHeight="0dp"
        android:paddingStart="@dimen/cetis_space_20"
        android:paddingTop="@dimen/cetis_space_12"
        android:paddingEnd="@dimen/cetis_space_20"
        android:paddingBottom="@dimen/cetis_space_12"
        android:stateListAnimator="@null"
        android:text="@string/boton_permitir_camara"
        android:textAllCaps="false"
        android:textColor="@color/cetis_text_on_brand"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/camara"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textoApunta"
        style="@style/Cetis.Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:gravity="center"
        android:text="@string/texto_apunta_camara"
        android:textColor="@color/cetis_text_on_brand_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camara" />

    <!-- "Registrando: Entrada" -->
    <TextView
        android:id="@+id/textoRegistrando"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/cetis_text_on_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoApunta"
        tools:text="Registrando: Entrada" />

    <!-- "Buscando al alumno…" o "Ese código no es de CetisAsiste." (solo si hay mensaje) -->
    <TextView
        android:id="@+id/textoEstado"
        style="@style/Cetis.Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_8"
        android:gravity="center"
        android:textColor="@color/cetis_text_on_brand"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoRegistrando"
        tools:text="{mensaje}"
        tools:visibility="visible" />

    <!-- Boton/Escribir matrícula (89:921): píldora con borde claro -->
    <Button
        android:id="@+id/botonEscribir"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="wrap_content"
        android:layout_height="41dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/shape_boton_borde_claro"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="21.5dp"
        android:paddingEnd="21.5dp"
        android:stateListAnimator="@null"
        android:text="@string/boton_escribir_no_control"
        android:textAllCaps="false"
        android:textColor="@color/cetis_text_on_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEstado" />
</androidx.constraintlayout.widget.ConstraintLayout>
