<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Inicio - Profesor" (78:1083). La lista de grupos puede crecer: la pantalla no cabe y
     lleva ScrollView con un solo ConstraintLayout adentro.
     Diferencias permitidas: menú ☰ en lugar de la barra de abajo y la campana arriba. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla.Desplazable">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenido"
        style="@style/Cetis.Pantalla.Contenido">

        <include
            android:id="@+id/barraInicio"
            layout="@layout/comun_barra_inicio"
            android:layout_width="0dp"
            android:layout_height="@dimen/cetis_app_bar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Greeting: nombre y área -->
        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barraInicio"
            tools:text="{personal.nombre}" />

        <TextView
            android:id="@+id/textoArea"
            style="@style/Cetis.Texto.CuerpoChico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/area_docente_plantel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoNombre" />

        <!-- SalidaCTA (78:1112): grupo de la última clase de hoy -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaDarSalida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:background="@drawable/shape_tarjeta_brand"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="94dp"
            android:padding="@dimen/cetis_space_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoArea">

            <ImageView
                android:id="@+id/tarjetaDarSalidaIcono"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shape_circulo_blanco"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_log_out"
                android:tint="@color/cetis_brand_800"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tarjetaDarSalidaTitulo"
                style="@style/Cetis.Texto.Banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_16"
                android:layout_marginEnd="@dimen/cetis_space_16"
                android:text="@string/titulo_dar_salida"
                android:textColor="@color/cetis_text_on_brand"
                app:layout_constraintBottom_toTopOf="@id/tarjetaDarSalidaDetalle"
                app:layout_constraintEnd_toStartOf="@id/tarjetaDarSalidaFlecha"
                app:layout_constraintStart_toEndOf="@id/tarjetaDarSalidaIcono"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tarjetaDarSalidaDetalle"
                style="@style/Cetis.Texto.CuerpoChico"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="@string/detalle_dar_salida"
                android:textColor="@color/cetis_text_on_brand_muted"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/tarjetaDarSalidaTitulo"
                app:layout_constraintStart_toStartOf="@id/tarjetaDarSalidaTitulo"
                app:layout_constraintTop_toBottomOf="@id/tarjetaDarSalidaTitulo" />

            <ImageView
                android:id="@+id/tarjetaDarSalidaFlecha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_light"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- MisGrupos (78:1121): un renglón por grupo (profesor_item_alumno.xml) -->
        <TextView
            android:id="@+id/textoMisGrupos"
            style="@style/Cetis.Subtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:text="@string/seccion_mis_grupos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaDarSalida" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaGrupos"
            style="@style/Cetis.Lista.Fija"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoMisGrupos"
            tools:itemCount="3"
            tools:listitem="@layout/profesor_item_alumno" />

        <TextView
            android:id="@+id/textoVacio"
            style="@style/Cetis.Texto.Vacio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vacio_grupos_profesor"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/listaGrupos" />

        <!-- Card/Boletin (78:1156): a todo lo ancho -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tarjetaBoletin"
            style="@style/Cetis.Tarjeta.Tocable"
            android:layout_width="0dp"
            android:layout_height="128dp"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:padding="@dimen/cetis_space_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoVacio">

            <ImageView
                android:id="@+id/tarjetaBoletinIcono"
                style="@style/Cetis.Circulo"
                android:src="@drawable/ic_announcements"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/tarjetaBoletinFlecha"
                style="@style/Cetis.Flecha"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tarjetaBoletinTitulo"
                style="@style/Cetis.Texto.TituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cetis_space_8"
                android:text="@string/acceso_boletin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaBoletinIcono" />

            <TextView
                android:id="@+id/tarjetaBoletinDetalle"
                style="@style/Cetis.Texto.SubtituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/acceso_boletin_detalle_profesor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaBoletinTitulo" />

            <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
            <ImageView
                android:id="@+id/tarjetaBoletinEsquina"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:translationX="@dimen/cetis_space_12"
                android:translationY="@dimen/cetis_space_12"
                android:src="@drawable/img_corner_accent_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
