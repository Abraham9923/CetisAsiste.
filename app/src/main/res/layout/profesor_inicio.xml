<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio del profesor. No hay Figma de este rol: usa el diseño de "Inicio - Alumno"
     (encabezado y tarjeta de perfil) y las piezas de "Componentes".
     Pestaña: el botón ☰ abre el menú del rol.
     Variables: personal.nombre, cuántos grupos tiene y la lista de sus grupos
     (un comun_item_lista por grupo; al tocarlo se abre el grupo). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <LinearLayout style="@style/Cetis.Pantalla.Columna">

        <!-- Header (como Figma 79:1300) -->
        <FrameLayout style="@style/Cetis.BarraSuperior">

            <ImageView style="@style/Cetis.BarraSuperior.Adorno" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:paddingStart="@dimen/cetis_space_16"
                android:paddingEnd="@dimen/cetis_space_16">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu"
                    android:layout_gravity="start|center_vertical" />

                <TextView
                    style="@style/Cetis.Texto.Banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textColor="@color/cetis_text_on_brand" />

                <ImageButton
                    android:id="@+id/btn_notificaciones"
                    style="@style/Cetis.BarraSuperior.Campana"
                    android:layout_gravity="end|center_vertical" />
            </FrameLayout>
        </FrameLayout>

        <ScrollView style="@style/Cetis.Pantalla.Scroll">

            <LinearLayout style="@style/Cetis.Pantalla.Contenido">

                <!-- ProfileCard · variables: personal.nombre, rol y cuántos grupos tiene -->
                <FrameLayout
                    android:id="@+id/tarjeta_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:background="@drawable/shape_tarjeta"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/cetis_space_16"
                        android:paddingEnd="@dimen/cetis_space_16">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_avatar_64" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_nombre"
                                style="@style/Cetis.Texto.TituloNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                tools:text="{personal.nombre}" />

                            <TextView
                                style="@style/Cetis.Texto.Cuerpo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:text="@string/profesor_rol" />

                            <TextView
                                android:id="@+id/txt_grupos"
                                style="@style/Cetis.Texto.Cuerpo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                tools:text="{n} grupos este semestre" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/img_watermark_gear_card" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="54dp"
                        android:layout_marginEnd="19dp"
                        android:alpha="0.09"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:importantForAccessibility="no"
                        android:text="@string/alumno_marca_agua_numero"
                        android:textColor="@color/cetis_brand_800"
                        android:textSize="40sp" />
                </FrameLayout>

                <!-- SectionLabel -->
                <LinearLayout style="@style/Cetis.Seccion">

                    <View style="@style/Cetis.Seccion.Linea" />

                    <TextView
                        style="@style/Cetis.Seccion.Pildora"
                        android:text="@string/profesor_seccion_grupos" />

                    <View style="@style/Cetis.Seccion.Linea" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lista_grupos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_8"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_vacio"
                    style="@style/Cetis.Texto.Vacio"
                    android:text="@string/profesor_grupos_vacio"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
