<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "StudentRow" (76:542), renglón de lista (RecyclerView), no es pantalla.
     Alumno del grupo (Lista de alumnos 78:1084): iniciales en círculo claro, nombre, No. de
     control y su último estatus (StatusChip verde, amarillo o rojo).
     Grupo del profesor (Mis grupos de 78:1121): el número del grupo en círculo guinda, sin
     etiqueta. Los colores y lo que se ve los pone el código.
     Variables: alumno.iniciales, alumno.nombre, alumno.noControl, alumno.estatus -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Tarjeta.Tocable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cetis_space_8"
    android:padding="@dimen/cetis_space_12">

    <TextView
        android:id="@+id/textoIniciales"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/shape_circulo_iniciales"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="{alumno.iniciales}" />

    <TextView
        android:id="@+id/textoNombre"
        style="@style/Cetis.Texto.TituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_12"
        android:layout_marginEnd="@dimen/cetis_space_12"
        app:layout_constraintBottom_toTopOf="@id/textoDetalle"
        app:layout_constraintEnd_toStartOf="@id/imagenFlecha"
        app:layout_constraintStart_toEndOf="@id/textoIniciales"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="{alumno.nombre}" />

    <TextView
        android:id="@+id/textoDetalle"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/textoEstatus"
        app:layout_constraintEnd_toEndOf="@id/textoNombre"
        app:layout_constraintStart_toStartOf="@id/textoNombre"
        app:layout_constraintTop_toBottomOf="@id/textoNombre"
        tools:text="No. de control {alumno.noControl}" />

    <!-- StatusChip (el punto es el drawableStart; color según el estatus) -->
    <TextView
        android:id="@+id/textoEstatus"
        style="@style/Cetis.Estatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/textoNombre"
        app:layout_constraintTop_toBottomOf="@id/textoDetalle"
        tools:text="{alumno.estatus}" />

    <ImageView
        android:id="@+id/imagenFlecha"
        style="@style/Cetis.Flecha"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
