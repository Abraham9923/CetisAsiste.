<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Confirmar cerrar sesion - Alumno" (124:1923)
     Es la pantalla de Perfil con la capa oscura y el diálogo encima. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/alumno_perfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay rgba(20, 8, 10, 0.6) -->
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cetis_overlay"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <include
        android:id="@+id/dialogo_cerrar_sesion"
        layout="@layout/alumno_dialogo_cerrar_sesion"
        android:layout_width="296dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
