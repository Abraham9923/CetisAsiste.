<?xml version="1.0" encoding="utf-8"?>
<!-- Una opción del menú hamburguesa (comun_menu.xml): círculo guinda con el ícono y el nombre de
     la pantalla. Renglón de lista (RecyclerView). La de la pantalla abierta lleva fondo de
     tarjeta (lo pone el código). Variables: icono y texto de la opción. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Tarjeta.Tocable"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="@dimen/cetis_space_4"
    android:background="@null"
    android:paddingStart="@dimen/cetis_space_12"
    android:paddingEnd="@dimen/cetis_space_12"
    tools:background="@drawable/shape_tarjeta">

    <ImageView
        android:id="@+id/iconoOpcion"
        style="@style/Cetis.Circulo.Chico"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_home" />

    <TextView
        android:id="@+id/textoOpcion"
        style="@style/Cetis.Menu.Texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconoOpcion"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="{opcion.texto}" />
</androidx.constraintlayout.widget.ConstraintLayout>
