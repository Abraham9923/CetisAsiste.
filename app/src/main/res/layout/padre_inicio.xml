<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Inicio - Android" del padre (3:33). Cabe en la pantalla: sin ScrollView.
     Los datos son los del hijo. El encabezado de Figma no lleva "CetisAsiste": la app lo oculta.
     Diferencias permitidas: menú ☰ en lugar de la barra de abajo y la campana arriba. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraInicio"
        layout="@layout/comun_barra_inicio"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ProfileCard (79:1321) · variables: alumno.nombre, alumno.rol, alumno.grupo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaPerfil"
        style="@style/Cetis.Tarjeta"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraInicio">

        <!-- WatermarkGear + Watermark61 (detrás del texto) -->
        <ImageView
            android:id="@+id/imagenMarcaAgua"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/img_watermark_gear_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoMarcaAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="19dp"
            android:alpha="0.09"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:importantForAccessibility="no"
            android:text="@string/marca_agua_numero"
            android:textColor="@color/cetis_brand_800"
            android:textSize="40sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imagenFoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:contentDescription="@string/descripcion_foto_alumno"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_64"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoNombre"
            style="@style/Cetis.Texto.TituloNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:layout_marginEnd="@dimen/cetis_space_16"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/textoRol"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imagenFoto"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="{alumno.nombre}" />

        <TextView
            android:id="@+id/textoRol"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/textoGrupo"
            app:layout_constraintEnd_toEndOf="@id/textoNombre"
            app:layout_constraintStart_toStartOf="@id/textoNombre"
            app:layout_constraintTop_toBottomOf="@id/textoNombre"
            tools:text="{alumno.rol}" />

        <TextView
            android:id="@+id/textoGrupo"
            style="@style/Cetis.Texto.Cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/textoNombre"
            app:layout_constraintStart_toStartOf="@id/textoNombre"
            app:layout_constraintTop_toBottomOf="@id/textoRol"
            tools:text="{alumno.grupo}" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ImportantBanner (3:73) · variable: título del anuncio destacado. Se oculta si no hay. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaImportante"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:background="@drawable/shape_tarjeta_brand"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaPerfil"
        tools:visibility="visible">

        <!-- WatermarkGear de 150: más alto que la tarjeta, por eso queda recortado -->
        <ImageView
            android:id="@+id/imagenMarcaAguaImportante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/img_watermark_gear_banner"
            android:translationY="-10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iconoImportante"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/cetis_space_16"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divisorImportante"
            android:layout_width="1dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:alpha="0.6"
            android:background="@color/cetis_text_on_brand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconoImportante"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tituloImportante"
            style="@style/Cetis.Texto.Banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cetis_space_12"
            android:layout_marginTop="@dimen/cetis_space_16"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/titulo_informacion_importante"
            android:textColor="@color/cetis_text_on_brand"
            app:layout_constraintEnd_toStartOf="@id/flechaImportante"
            app:layout_constraintStart_toEndOf="@id/divisorImportante"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoImportante"
            style="@style/Cetis.Texto.CuerpoChico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/cetis_space_16"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/cetis_text_on_brand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tituloImportante"
            app:layout_constraintStart_toStartOf="@id/tituloImportante"
            app:layout_constraintTop_toBottomOf="@id/tituloImportante"
            tools:text="{aviso.titulo}" />

        <ImageView
            android:id="@+id/flechaImportante"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/cetis_space_12"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SectionLabel: línea · píldora · línea -->
    <TextView
        android:id="@+id/textoAccesosRapidos"
        style="@style/Cetis.Seccion.Pildora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/seccion_accesos_rapidos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaImportante" />

    <View
        android:id="@+id/textoAccesosRapidosLineaIzquierda"
        style="@style/Cetis.Seccion.Linea"
        android:layout_width="0dp"
        android:layout_marginEnd="@dimen/cetis_space_12"
        app:layout_constraintBottom_toBottomOf="@id/textoAccesosRapidos"
        app:layout_constraintEnd_toStartOf="@id/textoAccesosRapidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoAccesosRapidos" />

    <View
        android:id="@+id/textoAccesosRapidosLineaDerecha"
        style="@style/Cetis.Seccion.Linea"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/cetis_space_12"
        app:layout_constraintBottom_toBottomOf="@id/textoAccesosRapidos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textoAccesosRapidos"
        app:layout_constraintTop_toTopOf="@id/textoAccesosRapidos" />

    <!-- Rejilla de accesos: dos columnas de 162 dp con 12 dp entre ellas -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaCentro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Card/QR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaQr"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:padding="@dimen/cetis_space_12"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@id/guiaCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoAccesosRapidos">

        <ImageView
            android:id="@+id/tarjetaQrIcono"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_qr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tarjetaQrFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tarjetaQrTitulo"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_codigo_qr_identificacion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaQrIcono" />

        <TextView
            android:id="@+id/tarjetaQrDetalle"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_codigo_qr_identificacion_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaQrTitulo" />

        <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
        <ImageView
            android:id="@+id/tarjetaQrEsquina"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:translationX="@dimen/cetis_space_12"
            android:translationY="@dimen/cetis_space_12"
            android:src="@drawable/img_corner_accent_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card/Credencial -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaCredencial"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:padding="@dimen/cetis_space_12"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaCentro"
        app:layout_constraintTop_toTopOf="@id/tarjetaQr">

        <ImageView
            android:id="@+id/tarjetaCredencialIcono"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_id_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tarjetaCredencialFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tarjetaCredencialTitulo"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_credencial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaCredencialIcono" />

        <TextView
            android:id="@+id/tarjetaCredencialDetalle"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_credencial_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaCredencialTitulo" />

        <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
        <ImageView
            android:id="@+id/tarjetaCredencialEsquina"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:translationX="@dimen/cetis_space_12"
            android:translationY="@dimen/cetis_space_12"
            android:src="@drawable/img_corner_accent_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card/Entradas y salidas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaEntradas"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_marginTop="@dimen/cetis_space_12"
        android:padding="@dimen/cetis_space_12"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@id/guiaCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaQr">

        <ImageView
            android:id="@+id/tarjetaEntradasIcono"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_inbox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tarjetaEntradasFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tarjetaEntradasTitulo"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_entradas_salidas"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaEntradasIcono" />

        <TextView
            android:id="@+id/tarjetaEntradasDetalle"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_entradas_salidas_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaEntradasTitulo" />

        <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
        <ImageView
            android:id="@+id/tarjetaEntradasEsquina"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:translationX="@dimen/cetis_space_12"
            android:translationY="@dimen/cetis_space_12"
            android:src="@drawable/img_corner_accent_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card/Horario -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaHorario"
        style="@style/Cetis.Tarjeta.Tocable"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:padding="@dimen/cetis_space_12"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaCentro"
        app:layout_constraintTop_toTopOf="@id/tarjetaEntradas">

        <ImageView
            android:id="@+id/tarjetaHorarioIcono"
            style="@style/Cetis.Circulo"
            android:src="@drawable/ic_clock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tarjetaHorarioFlecha"
            style="@style/Cetis.Flecha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tarjetaHorarioTitulo"
            style="@style/Cetis.Texto.TituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:text="@string/acceso_horario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaHorarioIcono" />

        <TextView
            android:id="@+id/tarjetaHorarioDetalle"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/acceso_horario_detalle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjetaHorarioTitulo" />

        <!-- CornerAccent: pegado a la esquina inferior derecha (se recorre los 12 dp del relleno) -->
        <ImageView
            android:id="@+id/tarjetaHorarioEsquina"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:translationX="@dimen/cetis_space_12"
            android:translationY="@dimen/cetis_space_12"
            android:src="@drawable/img_corner_accent_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
