<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Inicio" del padre (antes InicioScreen.kt en Compose). Pestaña: el botón ☰ abre el
     menú del rol. Variables: alumno.nombre, alumno.rol, alumno.grupo (datos del hijo) y
     el título del anuncio destacado (si no hay, el recuadro guinda no se ve). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <LinearLayout style="@style/Cetis.Pantalla.Columna">

        <!-- Header (Figma 79:1300) -->
        <FrameLayout style="@style/Cetis.BarraSuperior">

            <ImageView style="@style/Cetis.BarraSuperior.Adorno" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:paddingStart="@dimen/cetis_space_16"
                android:paddingEnd="@dimen/cetis_space_16">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu"
                    android:layout_gravity="start|center_vertical" />

                <TextView
                    style="@style/Cetis.Texto.Banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textColor="@color/cetis_text_on_brand" />

                <ImageButton
                    android:id="@+id/btn_notificaciones"
                    style="@style/Cetis.BarraSuperior.Campana"
                    android:layout_gravity="end|center_vertical" />
            </FrameLayout>
        </FrameLayout>

        <ScrollView style="@style/Cetis.Pantalla.Scroll">

            <LinearLayout style="@style/Cetis.Pantalla.Contenido">

                <!-- ProfileCard · variables: alumno.nombre, alumno.rol, alumno.grupo -->
                <FrameLayout
                    android:id="@+id/tarjeta_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:background="@drawable/shape_tarjeta"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/cetis_space_16"
                        android:paddingEnd="@dimen/cetis_space_16">

                        <ImageView
                            android:id="@+id/img_foto"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="@string/alumno_foto_descripcion"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_avatar_64" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_nombre"
                                style="@style/Cetis.Texto.TituloNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                tools:text="{alumno.nombre}" />

                            <TextView
                                android:id="@+id/txt_rol"
                                style="@style/Cetis.Texto.Cuerpo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                tools:text="{alumno.rol}" />

                            <TextView
                                android:id="@+id/txt_grupo"
                                style="@style/Cetis.Texto.Cuerpo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                tools:text="{alumno.grupo}" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Marca de agua: engrane + "61" -->
                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/img_watermark_gear_card" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="54dp"
                        android:layout_marginEnd="19dp"
                        android:alpha="0.09"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:importantForAccessibility="no"
                        android:text="@string/alumno_marca_agua_numero"
                        android:textColor="@color/cetis_brand_800"
                        android:textSize="40sp" />
                </FrameLayout>

                <!-- ImportantBanner · variable: título del anuncio destacado -->
                <FrameLayout
                    android:id="@+id/banner_importante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:background="@drawable/shape_tarjeta_brand"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Engrane decorativo: más alto que la tarjeta, por eso queda recortado -->
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-10dp"
                        android:layout_marginEnd="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/img_watermark_gear_banner" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/cetis_space_16"
                        android:paddingTop="@dimen/cetis_space_16"
                        android:paddingEnd="@dimen/cetis_space_12"
                        android:paddingBottom="@dimen/cetis_space_16">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_warning" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:alpha="0.6"
                            android:background="@color/cetis_text_on_brand" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_marginEnd="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Cetis.Texto.Banner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/home_banner_title"
                                android:textColor="@color/cetis_text_on_brand" />

                            <TextView
                                android:id="@+id/txt_banner"
                                style="@style/Cetis.Texto.CuerpoChico"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/cetis_space_4"
                                android:textColor="@color/cetis_text_on_brand"
                                tools:text="{aviso.titulo}" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right_light" />
                    </LinearLayout>
                </FrameLayout>

                <!-- SectionLabel -->
                <LinearLayout style="@style/Cetis.Seccion">

                    <View style="@style/Cetis.Seccion.Linea" />

                    <TextView
                        style="@style/Cetis.Seccion.Pildora"
                        android:text="@string/home_quick_access" />

                    <View style="@style/Cetis.Seccion.Linea" />
                </LinearLayout>

                <!-- QuickAccessGrid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/card_qr"
                        style="@style/Cetis.Acceso"
                        android:layout_marginEnd="@dimen/cetis_space_12">

                        <LinearLayout style="@style/Cetis.Acceso.Contenido">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <FrameLayout style="@style/Cetis.Circulo">

                                    <ImageView style="@style/Cetis.Circulo.Icono" android:src="@drawable/ic_qr" />
                                </FrameLayout>

                                <ImageView style="@style/Cetis.Acceso.Flecha" />
                            </FrameLayout>

                            <TextView
                                style="@style/Cetis.Acceso.Titulo"
                                android:text="@string/home_qr_title" />

                            <TextView
                                style="@style/Cetis.Acceso.Subtitulo"
                                android:text="@string/home_qr_subtitle" />
                        </LinearLayout>

                        <ImageView style="@style/Cetis.Acceso.Esquina" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/card_credencial"
                        style="@style/Cetis.Acceso">

                        <LinearLayout style="@style/Cetis.Acceso.Contenido">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <FrameLayout style="@style/Cetis.Circulo">

                                    <ImageView style="@style/Cetis.Circulo.Icono" android:src="@drawable/ic_id_card" />
                                </FrameLayout>

                                <ImageView style="@style/Cetis.Acceso.Flecha" />
                            </FrameLayout>

                            <TextView
                                style="@style/Cetis.Acceso.Titulo"
                                android:text="@string/credencial_title" />

                            <TextView
                                style="@style/Cetis.Acceso.Subtitulo"
                                android:text="@string/home_credencial_subtitle" />
                        </LinearLayout>

                        <ImageView style="@style/Cetis.Acceso.Esquina" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_12"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/card_entradas"
                        style="@style/Cetis.Acceso"
                        android:layout_marginEnd="@dimen/cetis_space_12">

                        <LinearLayout style="@style/Cetis.Acceso.Contenido">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <FrameLayout style="@style/Cetis.Circulo">

                                    <ImageView style="@style/Cetis.Circulo.Icono" android:src="@drawable/ic_inbox" />
                                </FrameLayout>

                                <ImageView style="@style/Cetis.Acceso.Flecha" />
                            </FrameLayout>

                            <TextView
                                style="@style/Cetis.Acceso.Titulo"
                                android:text="@string/entradas_title" />

                            <TextView
                                style="@style/Cetis.Acceso.Subtitulo"
                                android:text="@string/home_entradas_subtitle" />
                        </LinearLayout>

                        <ImageView style="@style/Cetis.Acceso.Esquina" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/card_horario"
                        style="@style/Cetis.Acceso">

                        <LinearLayout style="@style/Cetis.Acceso.Contenido">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <FrameLayout style="@style/Cetis.Circulo">

                                    <ImageView style="@style/Cetis.Circulo.Icono" android:src="@drawable/ic_clock" />
                                </FrameLayout>

                                <ImageView style="@style/Cetis.Acceso.Flecha" />
                            </FrameLayout>

                            <TextView
                                style="@style/Cetis.Acceso.Titulo"
                                android:text="@string/horario_title" />

                            <TextView
                                style="@style/Cetis.Acceso.Subtitulo"
                                android:text="@string/home_horario_subtitle" />
                        </LinearLayout>

                        <ImageView style="@style/Cetis.Acceso.Esquina" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
