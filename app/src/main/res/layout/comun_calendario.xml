<?xml version="1.0" encoding="utf-8"?>
<!-- Calendario del plantel (frame "Calendario" de Figma). Lo usan el padre y el prefecto.
     Pestaña: el botón ☰ abre el menú del rol.
     Variables: mes (título, días, hoy, días con evento) y la lista de eventos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <LinearLayout style="@style/Cetis.Pantalla.Columna">

        <FrameLayout style="@style/Cetis.BarraSuperior">

            <ImageView style="@style/Cetis.BarraSuperior.Adorno" />

            <LinearLayout style="@style/Cetis.BarraSuperior.Fila">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.BarraSuperior.Titulo"
                    android:text="@string/nav_calendario" />
                <!-- Campana: la muestra y la conecta el código (PantallaXml) -->
                <ImageButton
                    android:id="@+id/btn_notificaciones"
                    style="@style/Cetis.BarraSuperior.Campana"
                    android:layout_marginStart="@dimen/cetis_space_8"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView style="@style/Cetis.Pantalla.Scroll">

            <LinearLayout style="@style/Cetis.Pantalla.Contenido">

                <!-- MonthCard · variable: mes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:background="@drawable/shape_tarjeta"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/cetis_space_12"
                    android:paddingTop="@dimen/cetis_space_16"
                    android:paddingEnd="@dimen/cetis_space_12"
                    android:paddingBottom="@dimen/cetis_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_mes_anterior"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="-10dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/calendario_previous_month"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chevron_left_dark" />

                        <TextView
                            android:id="@+id/txt_mes"
                            style="@style/Cetis.Texto.Seccion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:gravity="center"
                            tools:text="{mes.titulo}" />

                        <ImageButton
                            android:id="@+id/btn_mes_siguiente"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="-10dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/calendario_next_month"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_chevron_right_dark" />
                    </LinearLayout>

                    <!-- L M M J V S D (el código pone las letras de calendario_weekdays) -->
                    <LinearLayout
                        android:id="@+id/dias_semana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:orientation="horizontal">

                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="L" />
                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="M" />
                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="M" />
                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="J" />
                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="V" />
                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="S" />
                        <TextView style="@style/Cetis.Texto.SubtituloTarjeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" tools:text="D" />
                    </LinearLayout>

                    <!-- Semanas: el código agrega un renglón de 7 casillas (comun_item_dia) por semana -->
                    <LinearLayout
                        android:id="@+id/calendario_semanas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:orientation="vertical" />
                </LinearLayout>

                <TextView
                    style="@style/Cetis.Subtitulo"
                    android:text="@string/calendario_upcoming" />

                <!-- Eventos: un comun_item_lista por evento -->
                <LinearLayout
                    android:id="@+id/lista_eventos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:layout_height="64dp" />

                <TextView
                    android:id="@+id/txt_vacio"
                    style="@style/Cetis.Texto.Vacio"
                    android:text="@string/vacio_eventos"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
