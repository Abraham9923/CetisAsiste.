<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Calendario - Android" del padre (22:241). También lo abre el prefecto.
     Los eventos están en un RecyclerView que se desplaza solo: sin ScrollView.
     Variables: mes.titulo, los días del mes (con hoy y los días con evento) y los eventos. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MonthCard (25:346): flechas, mes, letras de los días y la rejilla del mes -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tarjetaMes"
        style="@style/Cetis.Tarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:paddingStart="@dimen/cetis_space_12"
        android:paddingTop="@dimen/cetis_space_16"
        android:paddingEnd="@dimen/cetis_space_12"
        android:paddingBottom="@dimen/cetis_space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <!-- Flechas de 20 dp con 40 dp de toque (se recorren 10 dp para quedar donde dice Figma) -->
        <ImageButton
            android:id="@+id/botonMesAnterior"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accion_mes_anterior"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left_dark"
            android:translationX="-10dp"
            app:layout_constraintBottom_toBottomOf="@id/textoMes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textoMes" />

        <TextView
            android:id="@+id/textoMes"
            style="@style/Cetis.Texto.Seccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="{mes.titulo}" />

        <ImageButton
            android:id="@+id/botonMesSiguiente"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accion_mes_siguiente"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right_dark"
            android:translationX="10dp"
            app:layout_constraintBottom_toBottomOf="@id/textoMes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textoMes" />

        <!-- Weekdays: siete columnas iguales (cadena de restricciones) -->
        <TextView
            android:id="@+id/letraLunes"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_lunes"
            app:layout_constraintEnd_toStartOf="@id/letraMartes"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <TextView
            android:id="@+id/letraMartes"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_martes"
            app:layout_constraintEnd_toStartOf="@id/letraMiercoles"
            app:layout_constraintStart_toEndOf="@id/letraLunes"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <TextView
            android:id="@+id/letraMiercoles"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_miercoles"
            app:layout_constraintEnd_toStartOf="@id/letraJueves"
            app:layout_constraintStart_toEndOf="@id/letraMartes"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <TextView
            android:id="@+id/letraJueves"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_jueves"
            app:layout_constraintEnd_toStartOf="@id/letraViernes"
            app:layout_constraintStart_toEndOf="@id/letraMiercoles"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <TextView
            android:id="@+id/letraViernes"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_viernes"
            app:layout_constraintEnd_toStartOf="@id/letraSabado"
            app:layout_constraintStart_toEndOf="@id/letraJueves"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <TextView
            android:id="@+id/letraSabado"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_sabado"
            app:layout_constraintEnd_toStartOf="@id/letraDomingo"
            app:layout_constraintStart_toEndOf="@id/letraViernes"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <TextView
            android:id="@+id/letraDomingo"
            style="@style/Cetis.Texto.SubtituloTarjeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            android:gravity="center"
            android:text="@string/letra_domingo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/letraSabado"
            app:layout_constraintTop_toBottomOf="@id/textoMes" />

        <!-- Semanas: rejilla de 7 columnas (RecyclerView con comun_item_dia.xml) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaDias"
            style="@style/Cetis.Lista.Fija"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cetis_space_8"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/letraLunes"
            app:spanCount="7"
            tools:itemCount="31"
            tools:listitem="@layout/comun_item_dia" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- UpcomingEvents (25:472) -->
    <TextView
        android:id="@+id/textoProximosEventos"
        style="@style/Cetis.Subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/seccion_proximos_eventos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tarjetaMes" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaEventos"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoProximosEventos"
        tools:listitem="@layout/comun_item_lista" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vacio_eventos"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoProximosEventos" />
</androidx.constraintlayout.widget.ConstraintLayout>
