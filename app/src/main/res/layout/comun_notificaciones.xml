<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Notificaciones - Android" del padre (32:436) y "Notificaciones - Prefecto" (77:503).
     La usan todos los roles (campana y menú ☰). Los avisos están en un RecyclerView: sin ScrollView. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Group/Hoy: encabezado con "Marcar todas como leídas" a la derecha -->
    <TextView
        android:id="@+id/textoHoy"
        style="@style/Cetis.Subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/seccion_hoy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />

    <TextView
        android:id="@+id/textoMarcarLeidas"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/enlace_marcar_leidas"
        android:textColor="@color/cetis_brand_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/textoHoy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoHoy"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textoVacioHoy"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/vacio_notificaciones"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoHoy" />

    <!-- NotificationList: avisos de hoy, el encabezado "Anteriores" y los avisos anteriores
         (comun_item_notificacion.xml y comun_item_encabezado.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaNotificaciones"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoVacioHoy"
        tools:listitem="@layout/comun_item_notificacion" />
</androidx.constraintlayout.widget.ConstraintLayout>
