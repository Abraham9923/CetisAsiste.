<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "Clase" (una fila del horario, 79:1462). Renglón de lista (RecyclerView).
     Variables: clase.materia, clase.horario, clase.detalle -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cetis_space_8"
    android:padding="@dimen/cetis_space_12">

    <ImageView
        android:id="@+id/iconoClase"
        style="@style/Cetis.Circulo"
        android:padding="10dp"
        android:src="@drawable/ic_clock"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textoMateria"
        style="@style/Cetis.Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_12"
        app:layout_constraintBottom_toTopOf="@id/textoDetalle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconoClase"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="{clase.materia}" />

    <TextView
        android:id="@+id/textoDetalle"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/textoMateria"
        app:layout_constraintTop_toBottomOf="@id/textoMateria"
        tools:text="{clase.horario} · {clase.detalle}" />
</androidx.constraintlayout.widget.ConstraintLayout>
