<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "AppBar" (16:103) de las pantallas internas: ☰ + título a la izquierda.
     Se incluye en cada pantalla con <include android:id="@+id/barraSuperior" … />.
     Diferencias permitidas con Figma: la campana de la derecha (en todas las pantallas). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.BarraSuperior">

    <!-- DiagonalAccent -->
    <ImageView
        android:id="@+id/imagenAdorno"
        style="@style/Cetis.BarraSuperior.Adorno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Arriba quedan 32 dp para la hora y la batería que dibuja Android; el renglón de 44 dp
         va abajo (botones de 48 dp centrados en él). -->
    <ImageButton
        android:id="@+id/botonMenu"
        style="@style/Cetis.BarraSuperior.Menu"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textoTitulo"
        style="@style/Cetis.BarraSuperior.Titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="@dimen/cetis_space_8"
        app:layout_constraintBottom_toBottomOf="@id/botonMenu"
        app:layout_constraintEnd_toStartOf="@id/botonNotificaciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/botonMenu"
        tools:text="@string/titulo_codigo_qr" />

    <ImageButton
        android:id="@+id/botonNotificaciones"
        style="@style/Cetis.BarraSuperior.Campana"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="@id/botonMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/botonMenu" />
</androidx.constraintlayout.widget.ConstraintLayout>
