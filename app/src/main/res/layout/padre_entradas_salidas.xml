<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Entradas y salidas - Android" del padre (20:97). Es una lista (RecyclerView):
     sin ScrollView. Variables: nombre del hijo, días con sus entradas y salidas. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Un encabezado por día y un renglón por entrada o salida (comun_item_encabezado.xml y
         comun_item_lista.xml). La lista crece hasta llenar la pantalla y "Ver más" queda debajo. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaRegistros"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/textoVerMas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        tools:itemCount="4"
        tools:listitem="@layout/comun_item_lista" />

    <TextView
        android:id="@+id/textoVerMas"
        style="@style/Cetis.Texto.Enlace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_12"
        android:layout_marginBottom="@dimen/cetis_space_16"
        android:gravity="center"
        android:paddingTop="@dimen/cetis_space_8"
        android:paddingBottom="@dimen/cetis_space_8"
        android:text="@string/enlace_ver_mas"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listaRegistros"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/vacio_registros"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />
</androidx.constraintlayout.widget.ConstraintLayout>
