<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "AnnouncementCard" (22:232)
     Variables: anuncio.etiqueta, anuncio.fecha, anuncio.titulo, anuncio.texto -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_tarjeta"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/cetis_space_20"
        android:paddingTop="@dimen/cetis_space_16"
        android:paddingEnd="@dimen/cetis_space_16"
        android:paddingBottom="@dimen/cetis_space_16">

        <!-- Meta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_etiqueta"
                style="@style/Cetis.Texto.SubtituloTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_pill"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/cetis_brand_900"
                tools:text="{anuncio.etiqueta}" />

            <TextView
                android:id="@+id/txt_fecha"
                style="@style/Cetis.Texto.SubtituloTarjeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cetis_space_8"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                tools:text="{anuncio.fecha}" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_titulo"
            style="@style/Cetis.Texto.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="{anuncio.titulo}" />

        <TextView
            android:id="@+id/txt_texto"
            style="@style/Cetis.Texto.CuerpoChico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="{anuncio.texto}" />
    </LinearLayout>

    <!-- AccentStripe -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/cetis_brand_800" />
</FrameLayout>
