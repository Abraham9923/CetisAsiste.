<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "AnnouncementCard" (22:232). Renglón de lista (RecyclerView), no es pantalla.
     Variables: anuncio.etiqueta, anuncio.fecha, anuncio.titulo, anuncio.texto -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cetis_space_12">

    <!-- AccentStripe: franja guinda de 4 dp a todo lo alto -->
    <View
        android:id="@+id/franja"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/cetis_brand_800"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textoEtiqueta"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_pill"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:layout_marginStart="@dimen/cetis_space_20"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:textColor="@color/cetis_brand_900"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="{anuncio.etiqueta}" />

    <TextView
        android:id="@+id/textoFecha"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_8"
        android:layout_marginEnd="@dimen/cetis_space_16"
        android:gravity="end"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@id/textoEtiqueta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textoEtiqueta"
        app:layout_constraintTop_toTopOf="@id/textoEtiqueta"
        tools:text="{anuncio.fecha}" />

    <TextView
        android:id="@+id/textoTitulo"
        style="@style/Cetis.Texto.Seccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@id/textoFecha"
        app:layout_constraintStart_toStartOf="@id/textoEtiqueta"
        app:layout_constraintTop_toBottomOf="@id/textoEtiqueta"
        tools:text="{anuncio.titulo}" />

    <TextView
        android:id="@+id/textoMensaje"
        style="@style/Cetis.Texto.CuerpoChico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingBottom="@dimen/cetis_space_16"
        app:layout_constraintEnd_toEndOf="@id/textoFecha"
        app:layout_constraintStart_toStartOf="@id/textoEtiqueta"
        app:layout_constraintTop_toBottomOf="@id/textoTitulo"
        tools:text="{anuncio.texto}" />
</androidx.constraintlayout.widget.ConstraintLayout>
