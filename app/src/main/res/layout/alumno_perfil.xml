<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Perfil - Alumno (79:1148)" -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cetis_surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/cetis_screen_margin"
        android:paddingEnd="@dimen/cetis_screen_margin">
        <!-- AppBar (Figma 16:103) -->
        <FrameLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cetis_app_bar_height"
            android:background="@drawable/shape_header"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="80dp"
                android:layout_gravity="end"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_header_accent" />

            <!-- La hora y la batería las dibuja Android en la zona superior -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/cetis_space_16"
                android:paddingEnd="@dimen/cetis_space_16">

                <ImageButton
                    android:id="@+id/btn_menu"
                    style="@style/Cetis.BarraSuperior.Menu" />

                <TextView
                    android:id="@+id/txt_titulo"
                    style="@style/Cetis.Texto.TituloNombre"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:maxLines="1"
                    android:text="@string/alumno_titulo_perfil"
                    android:textColor="@color/cetis_text_on_brand" />
                <!-- Campana: la muestra y la conecta el código (PantallaXml) -->
                <ImageButton
                    android:id="@+id/btn_notificaciones"
                    style="@style/Cetis.BarraSuperior.Campana"
                    android:layout_marginStart="@dimen/cetis_space_8"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/cetis_space_16"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- ProfileHeader (79:1515) · variables: alumno.nombre, alumno.rol, alumno.grupo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:background="@drawable/shape_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/cetis_space_16">

                    <ImageView
                        android:id="@+id/img_foto"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/alumno_foto_descripcion"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_avatar_72" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cetis_space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_nombre"
                            style="@style/Cetis.Texto.TituloNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="{alumno.nombre}" />

                        <TextView
                            android:id="@+id/txt_rol_grupo"
                            style="@style/Cetis.Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/cetis_text_secondary"
                            tools:text="{alumno.rol} · Grupo {alumno.grupo}" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Info (79:1522) · variables: alumno.noControl, alumno.grupo, alumno.correo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:background="@drawable/shape_tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/cetis_space_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Cetis.Campo.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/field_no_control" />

                        <TextView
                            android:id="@+id/txt_no_control"
                            style="@style/Cetis.Campo.Valor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            tools:text="{alumno.noControl}" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Cetis.Campo.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/field_grupo" />

                        <TextView
                            android:id="@+id/txt_grupo"
                            style="@style/Cetis.Campo.Valor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            tools:text="{alumno.grupo}" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Cetis.Campo.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/field_correo" />

                        <TextView
                            android:id="@+id/txt_correo"
                            style="@style/Cetis.Campo.Valor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            tools:text="{alumno.correo}" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Cetis.Texto.SubtituloTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:text="@string/alumno_perfil_aviso" />

                <!-- Options (79:1533) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cetis_space_16"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/opcion_qr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_tarjeta"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/cetis_space_12">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/shape_circulo_brand">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_qr" />
                        </FrameLayout>

                        <TextView
                            style="@style/Cetis.Texto.TituloTarjeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_marginEnd="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:text="@string/alumno_perfil_opcion_qr" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right_dark" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/opcion_credencial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:background="@drawable/shape_tarjeta"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/cetis_space_12">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/shape_circulo_brand">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_id_card" />
                        </FrameLayout>

                        <TextView
                            style="@style/Cetis.Texto.TituloTarjeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_marginEnd="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:text="@string/perfil_option_credencial" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right_dark" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/opcion_contrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:background="@drawable/shape_tarjeta"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/cetis_space_12">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/shape_circulo_brand">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_lock" />
                        </FrameLayout>

                        <TextView
                            style="@style/Cetis.Texto.TituloTarjeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_marginEnd="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:text="@string/perfil_option_password" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right_dark" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/opcion_cerrar_sesion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cetis_space_8"
                        android:background="@drawable/shape_tarjeta"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/cetis_space_12">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/shape_circulo_accent">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_log_out" />
                        </FrameLayout>

                        <TextView
                            style="@style/Cetis.Texto.TituloTarjeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cetis_space_12"
                            android:layout_marginEnd="@dimen/cetis_space_12"
                            android:layout_weight="1"
                            android:text="@string/perfil_option_logout" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right_dark" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
