<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "Lista de alumnos - Profesor" (78:1084). Título "Grupo 102", buscador y la lista de
     alumnos (RecyclerView, se desplaza sola: sin ScrollView). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Pantalla">

    <include
        android:id="@+id/barraSuperior"
        layout="@layout/comun_barra_superior"
        android:layout_width="0dp"
        android:layout_height="@dimen/cetis_app_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Buscar (78:1226): filtra la lista por nombre o No. de control -->
    <TextView
        android:id="@+id/etiquetaBuscar"
        style="@style/Cetis.Campo.Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:labelFor="@+id/campoBuscar"
        android:text="@string/campo_buscar_alumno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />

    <EditText
        android:id="@+id/campoBuscar"
        style="@style/Cetis.Campo.Caja"
        android:layout_width="0dp"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_search_field"
        android:hint="@string/pista_buscar_alumno"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etiquetaBuscar" />

    <!-- Alumnos (78:1238): profesor_item_alumno.xml -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaAlumnos"
        style="@style/Cetis.Lista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cetis_space_16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campoBuscar"
        tools:listitem="@layout/profesor_item_alumno" />

    <TextView
        android:id="@+id/textoVacio"
        style="@style/Cetis.Texto.Vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cetis_space_16"
        android:text="@string/vacio_alumnos"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campoBuscar" />
</androidx.constraintlayout.widget.ConstraintLayout>
