<?xml version="1.0" encoding="utf-8"?>
<!-- Renglón de lista (RecyclerView): ícono en un círculo, título y detalle ("ListItemCard" de Figma).
     Se usa en entradas y salidas, eventos, grupos, escaneos, salidas de grupo y alertas.
     Variables: renglon.titulo, renglon.detalle. El ícono, el color del círculo y la flecha
     (solo en los renglones que se pueden tocar) los pone el código. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Cetis.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/cetis_space_8"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="@dimen/cetis_space_12">

    <ImageView
        android:id="@+id/circuloIcono"
        style="@style/Cetis.Circulo"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_calendar_event" />

    <TextView
        android:id="@+id/textoTitulo"
        style="@style/Cetis.Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cetis_space_12"
        app:layout_constraintBottom_toTopOf="@id/textoDetalle"
        app:layout_constraintEnd_toStartOf="@id/imagenFlecha"
        app:layout_constraintStart_toEndOf="@id/circuloIcono"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="{renglon.titulo}" />

    <TextView
        android:id="@+id/textoDetalle"
        style="@style/Cetis.Texto.SubtituloTarjeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/textoTitulo"
        app:layout_constraintStart_toStartOf="@id/textoTitulo"
        app:layout_constraintTop_toBottomOf="@id/textoTitulo"
        tools:text="{renglon.detalle}" />

    <ImageView
        android:id="@+id/imagenFlecha"
        style="@style/Cetis.Flecha"
        android:layout_marginStart="@dimen/cetis_space_12"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
